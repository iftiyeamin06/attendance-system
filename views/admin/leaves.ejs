<%- include('partials/layout-header') %>

        <!-- Hero Header -->
        <div class="surface-card p-6 sm:p-8 relative overflow-hidden mb-6">
            <div class="absolute -top-20 -right-20 w-64 h-64 bg-indigo-100 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col md:flex-row justify-between md:items-center gap-4">
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Leave Management</p>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Employee Leave Records</h1>
                    <p class="text-sm text-slate-500">Approve full-day and partial (hourly) leaves for your team.</p>
                </div>
                <div class="flex items-center gap-3">
                    <button onclick="openMarkLeaveModal()" class="btn-primary">
                        <i class="fa-solid fa-calendar-plus text-sm"></i>
                        <span>Mark Employee Leave</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Leave Summary (KPI) -->
        <div class="mb-6">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Leave Summary</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="card-kpi card-kpi-blue p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-blue-700 uppercase tracking-wider">Total</span>
                        <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600">
                            <i class="fa-solid fa-calendar-days text-sm"></i>
                        </div>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                        <p id="kpi-total" class="text-3xl font-extrabold text-slate-900">0</p>
                        <span class="text-[11px] font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md border border-blue-200/50">Records</span>
                    </div>
                </div>

                <div class="card-kpi card-kpi-emerald p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Sick Leave</span>
                        <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center text-emerald-600">
                            <i class="fa-solid fa-notes-medical text-sm"></i>
                        </div>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                        <p id="kpi-sick" class="text-3xl font-extrabold text-slate-900">0</p>
                        <span class="text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200/50">Approved</span>
                    </div>
                </div>

                <div class="card-kpi card-kpi-indigo p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-indigo-700 uppercase tracking-wider">Paid Leave</span>
                        <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center text-indigo-600">
                            <i class="fa-solid fa-wallet text-sm"></i>
                        </div>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                        <p id="kpi-paid" class="text-3xl font-extrabold text-slate-900">0</p>
                        <span class="text-[11px] font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md border border-indigo-200/50">Approved</span>
                    </div>
                </div>

                <div class="card-kpi card-kpi-purple p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-purple-700 uppercase tracking-wider">Partial Day</span>
                        <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center text-purple-600">
                            <i class="fa-solid fa-clock text-sm"></i>
                        </div>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                        <p id="kpi-partial" class="text-3xl font-extrabold text-slate-900">0</p>
                        <span class="text-[11px] font-semibold text-purple-600 bg-purple-50 px-2 py-0.5 rounded-md border border-purple-200/50">Hourly</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Leave Policy Guidelines -->
        <div class="surface-card p-5 mb-6 flex flex-col gap-3">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-clipboard-check text-sm"></i>
                </div>
                <h3 class="text-sm font-extrabold tracking-tight text-slate-900">Leave Policy Guidelines</h3>
            </div>
            <ul class="text-xs text-slate-500 space-y-2 font-medium">
                <li class="flex items-start space-x-2">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-xs mt-0.5"></i>
                    <span>Full-day leaves set the daily status to <b>ON_LEAVE</b>.</span>
                </li>
                <li class="flex items-start space-x-2">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-xs mt-0.5"></i>
                    <span>Late arrival partial leaves adjust grace period to <b>To Time</b>.</span>
                </li>
                <li class="flex items-start space-x-2">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-xs mt-0.5"></i>
                    <span>Early departure partial leaves are removed from that day's work time.</span>
                </li>
            </ul>
            <p class="pt-2.5 border-t border-slate-100 text-[11px] text-slate-400">
                <i class="fa-solid fa-shield-halved text-indigo-400 mr-1"></i> Changes take effect immediately in daily calculations.
            </p>
        </div>

        <!-- Mark Leave Modal -->
        <div id="leave-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-md transition-opacity" onclick="closeMarkLeaveModal()"></div>
            <div class="relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-200 max-h-full">
                <!-- Modal Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-purple-50 text-purple-600 rounded-2xl flex items-center justify-center font-bold shadow-xs">
                            <i class="fa-solid fa-calendar-plus text-base"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-extrabold text-slate-900">Mark Employee Leave</h2>
                            <p class="text-xs text-slate-400 font-medium">Record full day or partial day (hourly) leave approvals</p>
                        </div>
                    </div>
                    <button onclick="closeMarkLeaveModal()" class="w-8 h-8 bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-xl flex items-center justify-center transition">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="flex-1 overflow-y-auto p-6">
                    <form id="leave-form" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Select Employee</label>
                            <select id="leave-employee" required
                                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                            </select>
                        </div>

                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Leave Category</label>
                            <select id="leave-type" required
                                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                                <option value="sick">Sick Leave (Full Day)</option>
                                <option value="paid">Paid Leave (Full Day)</option>
                                <option value="unpaid">Unpaid Leave (Full Day)</option>
                                <option value="partial">Partial Day (Hourly Leave)</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Start Date</label>
                            <input type="date" id="leave-start" required
                                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                        </div>

                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">End Date</label>
                            <input type="date" id="leave-end" required
                                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                        </div>

                        <!-- Partial Day Hourly Options -->
                        <div id="partial-fields" class="md:col-span-2 hidden bg-purple-50/60 border border-purple-200/60 p-4 rounded-2xl">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-purple-900 text-xs font-bold uppercase tracking-wider mb-1.5">From Time</label>
                                    <input type="time" id="partial-from" value="09:00"
                                        class="w-full px-3.5 py-2 bg-white border border-purple-200 rounded-xl text-sm font-semibold focus:outline-none focus:border-purple-500">
                                </div>
                                <div>
                                    <label class="block text-purple-900 text-xs font-bold uppercase tracking-wider mb-1.5">To Time</label>
                                    <input type="time" id="partial-to" value="11:00"
                                        class="w-full px-3.5 py-2 bg-white border border-purple-200 rounded-xl text-sm font-semibold focus:outline-none focus:border-purple-500">
                                </div>
                                <div>
                                    <label class="block text-purple-900 text-xs font-bold uppercase tracking-wider mb-1.5">Calculated Duration</label>
                                    <input type="text" id="partial-hours-display" readonly
                                        class="w-full px-3.5 py-2 bg-purple-100 border border-purple-200 rounded-xl text-sm font-bold text-purple-800"
                                        value="2 hours">
                                    <input type="hidden" id="partial-hours" value="2">
                                </div>
                            </div>
                            <p class="text-xs text-purple-700 font-medium mt-2.5 flex items-center space-x-1.5">
                                <i class="fa-solid fa-circle-info"></i>
                                <span id="leave-hint"></span>
                            </p>
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Leave Reason / Notes</label>
                            <input type="text" id="leave-notes"
                                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                                placeholder="Optional explanation...">
                        </div>

                        <div class="md:col-span-2 pt-2 grid grid-cols-2 gap-3">
                            <button type="button" onclick="closeMarkLeaveModal()"
                                class="bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition">
                                Cancel
                            </button>
                            <button type="submit"
                                class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition shadow-sm flex items-center justify-center space-x-2">
                                <i class="fa-solid fa-check"></i>
                                <span>Save Leave Record</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- All Leaves Records -->
        <div class="surface-card overflow-hidden mb-8">
            <div class="px-6 py-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 bg-slate-50 border border-slate-200 rounded-lg flex items-center justify-center text-indigo-600">
                        <i class="fa-solid fa-list-check text-sm"></i>
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 tracking-tight">Approved Leave Records</h2>
                        <p class="text-xs text-slate-400 mt-0.5">History of all active and past leave entries</p>
                    </div>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50/60 border-b border-slate-100 text-[11px] uppercase tracking-wider font-semibold text-slate-400">
                        <tr>
                            <th class="py-3 px-6">Employee</th>
                            <th class="py-3 px-4">Type</th>
                            <th class="py-3 px-4">Date Range</th>
                            <th class="py-3 px-4">Details</th>
                            <th class="py-3 px-6">Action</th>
                        </tr>
                    </thead>
                    <tbody id="leaves-list" class="divide-y divide-slate-100">
                        <tr>
                            <td colspan="5" class="py-12 text-center text-slate-400 text-sm">
                                <div class="inline-flex items-center space-x-2">
                                    <i class="fa-solid fa-circle-notch fa-spin text-indigo-500 text-base"></i>
                                    <span>Loading leaves...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

<%- include('partials/layout-footer') %>

    <script>
        let officeStartMinutes = 540;
        let officeEndMinutes = 1020;

        async function loadOfficeTimes() {
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/settings/office-time`);
                const data = await response.json();
                const [sh, sm] = (data.data.office_start_time || '09:00').split(':').map(Number);
                const [eh, em] = (data.data.office_end_time || '17:00').split(':').map(Number);
                officeStartMinutes = sh * 60 + sm;
                officeEndMinutes = eh * 60 + em;
            } catch (err) { console.error(err); }
        }

        function openMarkLeaveModal() {
            document.getElementById('leave-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            document.getElementById('leave-employee').focus();
        }

        function closeMarkLeaveModal() {
            document.getElementById('leave-modal').classList.add('hidden');
            document.body.style.overflow = '';
        }

        function calculateHours() {
            const from = document.getElementById('partial-from').value;
            const to = document.getElementById('partial-to').value;
            if (!from || !to) return;

            const [fromH, fromM] = from.split(':').map(Number);
            const [toH, toM] = to.split(':').map(Number);
            const fromMin = fromH * 60 + fromM;
            const toMin = toH * 60 + toM;
            const totalMinutes = toMin - fromMin;

            if (totalMinutes <= 0) {
                document.getElementById('partial-hours-display').value = 'Invalid range';
                document.getElementById('partial-hours').value = 0;
                return;
            }

            const hours = totalMinutes / 60;
            document.getElementById('partial-hours').value = hours;
            document.getElementById('partial-hours-display').value = hours + (hours === 1 ? ' hour' : ' hours');

            const hint = document.getElementById('leave-hint');
            if (fromMin === officeStartMinutes) {
                hint.textContent = 'Late Arrival Leave — adjusted start time to ' + to + '. Employee won\'t be marked late if clocking in before ' + to + '.';
            } else if (toMin === officeEndMinutes) {
                hint.textContent = 'Early Departure Leave — ' + hours + 'h removed from the day\'s work time.';
            } else {
                hint.textContent = 'Mid-Shift Leave — ' + hours + 'h removed from the day\'s work time.';
            }
        }

        document.getElementById('leave-type').addEventListener('change', function() {
            const partialFields = document.getElementById('partial-fields');
            if (this.value === 'partial') {
                partialFields.classList.remove('hidden');
                calculateHours();
            } else {
                partialFields.classList.add('hidden');
            }
        });

        document.getElementById('partial-from').addEventListener('change', calculateHours);
        document.getElementById('partial-to').addEventListener('change', calculateHours);

        async function populateEmployeeDropdown() {
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users`);
                const data = await response.json();
                const employees = data.data.filter(u => u.role !== 'admin');
                const select = document.getElementById('leave-employee');
                select.innerHTML = employees.map(u => `<option value="${u.id}">${u.name}</option>`).join('');
            } catch (err) { console.error(err); }
        }

        async function loadLeaves() {
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/leaves`);
                const data = await response.json();
                const container = document.getElementById('leaves-list');

                const leaves = data.data || [];
                let total = 0, sick = 0, paid = 0, partial = 0;
                leaves.forEach(l => {
                    total++;
                    if (l.leave_type === 'sick') sick++;
                    else if (l.leave_type === 'paid') paid++;
                    else if (l.leave_type === 'partial') partial++;
                });
                document.getElementById('kpi-total').textContent = total;
                document.getElementById('kpi-sick').textContent = sick;
                document.getElementById('kpi-paid').textContent = paid;
                document.getElementById('kpi-partial').textContent = partial;

                if (leaves.length === 0) {
                    container.innerHTML = `
                        <tr>
                            <td colspan="5" class="py-12 text-center text-slate-400">
                                <i class="fa-regular fa-folder-open text-2xl text-slate-300 mb-2 block"></i>
                                <span>No leave records registered yet.</span>
                            </td>
                        </tr>
                    `;
                    return;
                }

                container.innerHTML = leaves.map(leave => {
                    const typeLabels = { sick: 'Sick Leave', paid: 'Paid Leave', unpaid: 'Unpaid Leave', partial: 'Partial Day' };
                    const typeColors = {
                        sick: 'bg-rose-50 text-rose-700 border-rose-200',
                        paid: 'bg-blue-50 text-blue-700 border-blue-200',
                        unpaid: 'bg-slate-100 text-slate-700 border-slate-200',
                        partial: 'bg-purple-50 text-purple-700 border-purple-200'
                    };
                    const typeLabel = typeLabels[leave.leave_type] || leave.leave_type;
                    const typeColor = typeColors[leave.leave_type] || 'bg-slate-100 text-slate-600 border-slate-200';

                    let partialInfo = '';
                    if (leave.leave_type === 'partial') {
                        const label = leave.partial_label || 'Partial';
                        partialInfo = `<span class="text-xs font-semibold text-purple-600"><i class="fa-regular fa-clock mr-1"></i>${leave.partial_hours}h (${leave.partial_from} - ${leave.partial_to}) &middot; ${label}</span>`;
                    }

                    const empInitial = (leave.employee_name || 'E').charAt(0).toUpperCase();

                    const statusBadge = leave.status === 'Approved' ? '<span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200/50">Approved</span>' : (leave.status === 'Rejected' ? '<span class="text-xs font-semibold text-rose-700 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200/50">Rejected</span>' : '<span class="text-xs font-semibold text-slate-600 bg-slate-50 px-2 py-0.5 rounded-md border border-slate-200/50">Pending</span>');
                    return `
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-3.5 px-6">
                                <div class="flex items-center space-x-3">
                                    <div class="w-8 h-8 bg-indigo-100 text-indigo-700 rounded-full flex items-center justify-center font-bold text-xs shadow-2xs">
                                        ${empInitial}
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-900 text-sm">${leave.employee_name}</div>
                                        <div class="text-[11px] text-slate-400 font-medium">${leave.employee_email}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4"><span class="px-3 py-1 text-xs font-bold rounded-xl border ${typeColor}">${typeLabel}</span></td>
                            <td class="py-3.5 px-4 font-semibold text-slate-700 text-xs">
                                <i class="fa-regular fa-calendar mr-1 text-slate-400"></i>${leave.start_date} to ${leave.end_date}
                            </td>
                            <td class="py-3.5 px-4">
                                ${partialInfo}
                                ${leave.notes ? `<p class="text-xs text-slate-400 italic font-medium mt-1">"${leave.notes}"</p>` : ''}
                            </td>
                            <td class="py-3.5 px-6 space-x-2">
                                ${statusBadge}
                                ${leave.status === 'Pending' ? `<button onclick="updateLeaveStatus('${leave.id}','Approved')" class="ml-2 w-8 h-8 bg-white hover:bg-emerald-50 text-emerald-600 border border-slate-200 hover:border-emerald-200 rounded-xl flex items-center justify-center transition shadow-2xs" title="Approve"><i class="fa-solid fa-check text-xs"></i></button>
                                <button onclick="updateLeaveStatus('${leave.id}','Rejected')" class="ml-2 w-8 h-8 bg-white hover:bg-rose-50 text-rose-600 border border-slate-200 hover:border-rose-200 rounded-xl flex items-center justify-center transition shadow-2xs" title="Reject"><i class="fa-solid fa-xmark text-xs"></i></button>` : ''}
                                <button onclick="deleteLeave('${leave.id}')" class="ml-2 w-8 h-8 bg-white hover:bg-rose-50 text-slate-400 hover:text-rose-600 border border-slate-200 hover:border-rose-200 rounded-xl flex items-center justify-center transition shadow-2xs" title="Remove leave">
                                    <i class="fa-regular fa-trash-can text-xs"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            } catch (err) { console.error(err); }
        }

        async function deleteLeave(leaveId) {
            if (!confirm('Remove this leave entry?')) return;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/leaves/${leaveId}`, { method: 'DELETE' });
                const data = await response.json();
                if (data.success) {
                    showMessage('Leave record removed', 'success');
                    loadLeaves();
                }
            } catch (err) { console.error(err); }
        }

        async function updateLeaveStatus(leaveId, status) {
            if (!confirm(`Are you sure you want to ${status.toLowerCase()} this request?`)) return;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/leaves/${leaveId}/status`, { method: 'POST', body: JSON.stringify({ status }) });
                const data = await response.json();
                if (data.success) {
                    showMessage(`Leave ${status.toLowerCase()}.`, 'success');
                    loadLeaves();
                } else {
                    showMessage(data.message || 'Failed', 'error');
                }
            } catch (err) { console.error(err); showMessage('An error occurred', 'error'); }
        }
            } catch (err) { console.error(err); }
        }

        document.getElementById('leave-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const leaveType = document.getElementById('leave-type').value;
            const body = {
                user_id: document.getElementById('leave-employee').value,
                start_date: document.getElementById('leave-start').value,
                end_date: document.getElementById('leave-end').value,
                leave_type: leaveType,
                notes: document.getElementById('leave-notes').value.trim() || undefined,
            };

            if (leaveType === 'partial') {
                body.partial_hours = parseFloat(document.getElementById('partial-hours').value);
                body.partial_from = document.getElementById('partial-from').value;
                body.partial_to = document.getElementById('partial-to').value;
            }

            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/leaves`, { method: 'POST', body: JSON.stringify(body) });
                const data = await response.json();
                if (data.success) {
                    showMessage('Leave marked successfully', 'success');
                    e.target.reset();
                    document.getElementById('partial-fields').classList.add('hidden');
                    closeMarkLeaveModal();
                    loadLeaves();
                } else {
                    alert(data.message || 'Failed to mark leave');
                }
            } catch (err) { console.error(err); }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !document.getElementById('leave-modal').classList.contains('hidden')) closeMarkLeaveModal();
        });

        populateEmployeeDropdown();
        loadOfficeTimes().then(() => loadLeaves());
    </script>
