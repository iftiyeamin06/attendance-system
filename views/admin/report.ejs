<%- include('partials/layout-header') %>

        <!-- Hero Header -->
        <div class="surface-card p-6 sm:p-8 relative overflow-hidden mb-6">
            <div class="absolute -top-20 -right-20 w-64 h-64 bg-indigo-100 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col md:flex-row justify-between md:items-center gap-4">
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Attendance Report</p>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Monthly Summary</h1>
                    <p class="text-sm text-slate-500">Complete attendance overview for all employees.</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center space-x-2 bg-white border border-slate-200 rounded-lg px-3 py-2 shadow-sm">
                        <i class="fa-regular fa-calendar text-slate-400 text-sm"></i>
                        <select id="month-select" onchange="loadReport()" class="bg-transparent text-sm font-semibold text-slate-700 focus:outline-none cursor-pointer">
                            <option value="0">January</option>
                            <option value="1">February</option>
                            <option value="2">March</option>
                            <option value="3">April</option>
                            <option value="4">May</option>
                            <option value="5">June</option>
                            <option value="6">July</option>
                            <option value="7">August</option>
                            <option value="8">September</option>
                            <option value="9">October</option>
                            <option value="10">November</option>
                            <option value="11">December</option>
                        </select>
                        <select id="year-select" onchange="loadReport()" class="bg-transparent text-sm font-semibold text-slate-700 focus:outline-none cursor-pointer">
                            <option value="2026">2026</option>
                            <option value="2025">2025</option>
                            <option value="2027">2027</option>
                        </select>
                    </div>
                    <button onclick="exportReport()" class="btn-primary">
                        <i class="fa-solid fa-file-csv text-sm"></i>
                        <span>Export CSV</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- KPI Summary Cards -->
        <div class="mb-6">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Executive Summary</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="card-kpi card-kpi-blue p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-blue-700 uppercase tracking-wider">Scheduled Shifts</span>
                        <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600">
                            <i class="fa-solid fa-clock text-sm"></i>
                        </div>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                        <p id="kpi-shifts" class="text-3xl font-extrabold text-slate-900">0</p>
                        <span class="text-[11px] font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md border border-blue-200/50">Total</span>
                    </div>
                </div>

                <div class="card-kpi card-kpi-emerald p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">On-Time</span>
                        <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center text-emerald-600">
                            <i class="fa-solid fa-check-circle text-sm"></i>
                        </div>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                        <p id="kpi-ontime" class="text-3xl font-extrabold text-slate-900">0</p>
                        <span class="text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200/50">Clock-Ins</span>
                    </div>
                </div>

                <div class="card-kpi card-kpi-amber p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-amber-700 uppercase tracking-wider">Late Arrivals</span>
                        <div class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center text-amber-600">
                            <i class="fa-solid fa-triangle-exclamation text-sm"></i>
                        </div>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                        <p id="kpi-late" class="text-3xl font-extrabold text-slate-900">0</p>
                        <span class="text-[11px] font-semibold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200/50">Incidents</span>
                    </div>
                </div>

                <div class="card-kpi card-kpi-indigo p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-indigo-700 uppercase tracking-wider">Approved Leaves</span>
                        <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center text-indigo-600">
                            <i class="fa-solid fa-calendar-check text-sm"></i>
                        </div>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                        <p id="kpi-leaves" class="text-3xl font-extrabold text-slate-900">0</p>
                        <span class="text-[11px] font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md border border-indigo-200/50">Total</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employee Report Table -->
        <div class="surface-card overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 bg-slate-50 border border-slate-200 rounded-lg flex items-center justify-center text-indigo-600">
                        <i class="fa-solid fa-table-list text-sm"></i>
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 tracking-tight">Employee Attendance</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Detailed breakdown per employee for selected month</p>
                    </div>
                </div>
                <div class="relative w-full sm:w-64">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="search-input" onkeyup="filterTable()" placeholder="Search employee..."
                        class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50/60 border-b border-slate-100 text-[11px] uppercase tracking-wider font-semibold text-slate-400">
                        <tr>
                            <th class="py-3.5 px-6">Employee</th>
                            <th class="py-3.5 px-4 text-center">Days Worked</th>
                            <th class="py-3.5 px-4 text-center">Hours</th>
                            <th class="py-3.5 px-4 text-center">On-Time</th>
                            <th class="py-3.5 px-4 text-center">Late</th>
                            <th class="py-3.5 px-4 text-center">Leave</th>
                            <th class="py-3.5 px-4 text-center">Absent</th>
                        </tr>
                    </thead>
                    <tbody id="report-table" class="divide-y divide-slate-100">
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="inline-flex items-center space-x-2">
                                    <i class="fa-solid fa-circle-notch fa-spin text-indigo-500 text-base"></i>
                                    <span>Loading report...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

<%- include('partials/layout-footer') %>

    <script>
        let allData = [];
        const DAKHA_TIME_ZONE = 'Asia/Dhaka';

        function dhakaDateParts(date = new Date()) {
            const parts = new Intl.DateTimeFormat('en-US', {
                timeZone: DAKHA_TIME_ZONE,
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hourCycle: 'h23',
            }).formatToParts(new Date(date));

            const mapped = {};
            for (const part of parts) {
                if (part.type !== 'literal') mapped[part.type] = part.value;
            }
            return mapped;
        }

        function dhakaMonthYearDate() {
            const parts = dhakaDateParts(new Date());
            return new Date(Number(parts.year), Number(parts.month) - 1, 1);
        }

        // Initialize selects to current month/year
        (function init() {
            const now = dhakaMonthYearDate();
            const monthSelect = document.getElementById('month-select');
            const yearSelect = document.getElementById('year-select');
            monthSelect.value = now.getMonth();
            yearSelect.value = now.getFullYear();
            loadReport();
        })();

        async function loadReport() {
            const month = document.getElementById('month-select').value;
            const year = document.getElementById('year-select').value;

            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/report/summary?month=${month}&year=${year}`);
                const data = await response.json();

                if (data.success) {
                    allData = data.data;
                    renderKpis(data.data.kpi);
                    renderTable(data.data.employees);
                }
            } catch (err) {
                console.error('Failed to load report:', err);
            }
        }

        function renderKpis(kpi) {
            document.getElementById('kpi-shifts').textContent = kpi.total_shifts || 0;
            document.getElementById('kpi-ontime').textContent = kpi.total_on_time || 0;
            document.getElementById('kpi-late').textContent = kpi.total_late || 0;
            document.getElementById('kpi-leaves').textContent = kpi.total_leaves || 0;
        }

        function renderTable(employees) {
            const tbody = document.getElementById('report-table');

            if (!employees || employees.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-12 text-center text-slate-400">
                            <i class="fa-regular fa-folder-open text-2xl text-slate-300 mb-2 block"></i>
                            <span>No employees found for this period.</span>
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = employees.map(emp => {
                const initial = (emp.name || 'U').charAt(0).toUpperCase();
                const roleBadge = emp.role === 'admin'
                    ? `<span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200/60">Admin</span>`
                    : `<span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-slate-100 text-slate-600">Employee</span>`;

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="py-3.5 px-6">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-indigo-100 text-indigo-700 rounded-full flex items-center justify-center font-bold text-xs shadow-2xs">
                                    ${initial}
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">${emp.name}</div>
                                    <div class="text-[11px] text-slate-400 font-medium">${emp.email}</div>
                                </div>
                                <div class="ml-auto">${roleBadge}</div>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="font-bold text-slate-700">${emp.total_days_worked}</span>
                            <span class="text-[10px] text-slate-400 ml-1">/ ${emp.total_workdays}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="font-semibold text-slate-700">${emp.total_hours_worked}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-emerald-50 text-emerald-700 border-emerald-200">${emp.on_time_days}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-amber-50 text-amber-700 border-amber-200">${emp.late_days}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-blue-50 text-blue-700 border-blue-200">${emp.leave_days}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-rose-50 text-rose-700 border-rose-200">${emp.absent_days}</span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function filterTable() {
            const input = document.getElementById('search-input').value.toLowerCase();
            const rows = document.querySelectorAll('#report-table tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }

        async function exportReport() {
            const month = document.getElementById('month-select').value;
            const year = document.getElementById('year-select').value;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/report/export?month=${month}&year=${year}`);
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `monthly_report_${year}-${String(parseInt(month) + 1).padStart(2, '0')}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            } catch (err) {
                console.error('Export failed:', err);
            }
        }
    </script>
