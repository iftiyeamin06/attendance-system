<%- include('partials/layout-header') %>

        <!-- Hero Header -->
        <div class="surface-card p-6 sm:p-8 relative overflow-hidden mb-6">
            <div class="absolute -top-20 -right-20 w-64 h-64 bg-indigo-100 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col md:flex-row justify-between md:items-center gap-4">
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Attendance Report</p>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-1" id="report-title">Monthly Summary</h1>
                    <p class="text-sm text-slate-500" id="report-subtitle">Complete attendance overview for all employees.</p>
                </div>
                <div class="flex items-center gap-3">
                    <div id="monthly-controls" class="flex items-center space-x-2 bg-white border border-slate-200 rounded-lg px-3 py-2 shadow-sm">
                        <i class="fa-regular fa-calendar text-slate-400 text-sm"></i>
                        <select id="month-select" onchange="loadReport()" class="bg-transparent text-sm font-semibold text-slate-700 focus:outline-none cursor-pointer">
                            <option value="0">January</option>
                            <option value="1">February</option>
                            <option value="2">March</option>
                            <option value="3">April</option>
                            <option value="4">May</option>
                            <option value="5">June</option>
                            <option value="6">July</option>
                            <option value="7">August</option>
                            <option value="8">September</option>
                            <option value="9">October</option>
                            <option value="10">November</option>
                            <option value="11">December</option>
                        </select>
                        <select id="year-select" onchange="loadReport()" class="bg-transparent text-sm font-semibold text-slate-700 focus:outline-none cursor-pointer">
                            <option value="2026">2026</option>
                            <option value="2025">2025</option>
                            <option value="2027">2027</option>
                        </select>
                    </div>
                    <div id="daily-controls" class="flex items-center space-x-2 bg-white border border-slate-200 rounded-lg px-3 py-2 shadow-sm">
                        <i class="fa-regular fa-calendar text-slate-400 text-sm"></i>
                        <input type="date" id="daily-date" onchange="switchView('daily'); loadDailyReport()"
                            class="bg-transparent text-sm font-semibold text-slate-700 focus:outline-none cursor-pointer">
                    </div>
                    <button id="monthly-export" onclick="exportReport()" class="btn-primary">
                        <i class="fa-solid fa-file-csv text-sm"></i>
                        <span>Export CSV</span>
                    </button>
                    <button id="daily-export" onclick="exportDailyReport()" class="btn-primary hidden">
                        <i class="fa-solid fa-file-csv text-sm"></i>
                        <span>Export CSV</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Monthly Employee Report Table -->
        <div id="monthly-view">
            <div class="surface-card overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 bg-slate-50 border border-slate-200 rounded-lg flex items-center justify-center text-indigo-600">
                            <i class="fa-solid fa-table-list text-sm"></i>
                        </div>
                        <div>
                            <h2 class="text-sm font-bold text-slate-900 tracking-tight">Employee Attendance</h2>
                            <p class="text-xs text-slate-400 mt-0.5">Detailed breakdown per employee for selected month</p>
                        </div>
                    </div>
                    <div class="relative w-full sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" id="search-input" onkeyup="filterTable()" placeholder="Search employee..."
                            class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50/60 border-b border-slate-100 text-[11px] uppercase tracking-wider font-semibold text-slate-400">
                            <tr>
                                <th class="py-3.5 px-6">Employee</th>
                                <th class="py-3.5 px-4 text-center">Days Worked</th>
                                <th class="py-3.5 px-4 text-center">Hours</th>
                                <th class="py-3.5 px-4 text-center">On-Time</th>
                                <th class="py-3.5 px-4 text-center">Late</th>
                                <th class="py-3.5 px-4 text-center" title="Sick leave days">Sick leave</th>
                                <th class="py-3.5 px-4 text-center" title="Paid leave days">Paid leave</th>
                                <th class="py-3.5 px-4 text-center" title="Unpaid leave days">Unpaid leave</th>
                                <th class="py-3.5 px-4 text-center" title="Partial leave days">Partial leave</th>
                                <th class="py-3.5 px-4 text-center">Absent</th>
                            </tr>
                        </thead>
                        <tbody id="report-table" class="divide-y divide-slate-100">
                            <tr>
                                <td colspan="10" class="py-12 text-center text-slate-400">
                                    <div class="inline-flex items-center space-x-2">
                                        <i class="fa-solid fa-circle-notch fa-spin text-indigo-500 text-base"></i>
                                        <span>Loading report...</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Daily Report View -->
        <div id="daily-view" class="hidden space-y-6">
            <!-- Daily KPI Cards -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                <div class="card-kpi card-kpi-green p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Present</span>
                        <div class="w-8 h-8 bg-emerald-50 rounded-lg flex items-center justify-center text-emerald-600">
                            <i class="fa-solid fa-user-check text-sm"></i>
                        </div>
                    </div>
                    <p id="daily-count-present" class="mt-3 text-3xl font-extrabold text-slate-900">0</p>
                </div>
                <div class="card-kpi card-kpi-amber p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Late</span>
                        <div class="w-8 h-8 bg-amber-50 rounded-lg flex items-center justify-center text-amber-600">
                            <i class="fa-solid fa-user-clock text-sm"></i>
                        </div>
                    </div>
                    <p id="daily-count-late" class="mt-3 text-3xl font-extrabold text-slate-900">0</p>
                </div>
                <div class="card-kpi card-kpi-rose p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Absent</span>
                        <div class="w-8 h-8 bg-rose-50 rounded-lg flex items-center justify-center text-rose-600">
                            <i class="fa-solid fa-user-xmark text-sm"></i>
                        </div>
                    </div>
                    <p id="daily-count-absent" class="mt-3 text-3xl font-extrabold text-slate-900">0</p>
                </div>
                <div class="card-kpi card-kpi-blue p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">On Leave</span>
                        <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center text-blue-600">
                            <i class="fa-solid fa-user-clock text-sm"></i>
                        </div>
                    </div>
                    <p id="daily-count-leave" class="mt-3 text-3xl font-extrabold text-slate-900">0</p>
                </div>
                <div class="card-kpi card-kpi-purple p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Partial</span>
                        <div class="w-8 h-8 bg-purple-50 rounded-lg flex items-center justify-center text-purple-600">
                            <i class="fa-solid fa-hourglass-half text-sm"></i>
                        </div>
                    </div>
                    <p id="daily-count-partial" class="mt-3 text-3xl font-extrabold text-slate-900">0</p>
                </div>
                <div class="card-kpi card-kpi-gray p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Holiday/Weekend</span>
                        <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center text-slate-600">
                            <i class="fa-solid fa-umbrella-beach text-sm"></i>
                        </div>
                    </div>
                    <p id="daily-count-off" class="mt-3 text-3xl font-extrabold text-slate-900">0</p>
                </div>
            </div>

            <!-- Daily Attendance Table -->
            <div class="surface-card overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 bg-slate-50 border border-slate-200 rounded-lg flex items-center justify-center text-indigo-600">
                            <i class="fa-solid fa-list-check text-sm"></i>
                        </div>
                        <div>
                            <h2 class="text-sm font-bold text-slate-900 tracking-tight">Daily Attendance Report</h2>
                            <p class="text-xs text-slate-400 mt-0.5" id="daily-report-subtitle">Attendance status for all employees</p>
                        </div>
                    </div>
                    <div class="relative w-full sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" id="daily-search-input" onkeyup="filterDailyTable()" placeholder="Search employee..."
                            class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50/60 border-b border-slate-100 text-[11px] uppercase tracking-wider font-semibold text-slate-400">
                            <tr>
                                <th class="py-3.5 px-6">Employee</th>
                                <th class="py-3.5 px-4 text-center">Status</th>
                                <th class="py-3.5 px-4 text-center">Clock In</th>
                                <th class="py-3.5 px-4 text-center">Clock Out</th>
                                <th class="py-3.5 px-4 text-center">Duration</th>
                                <th class="py-3.5 px-4 text-center">Late</th>
                            </tr>
                        </thead>
                        <tbody id="daily-table" class="divide-y divide-slate-100">
                            <tr>
                                <td colspan="6" class="py-12 text-center text-slate-400">
                                    <div class="inline-flex items-center space-x-2">
                                        <i class="fa-solid fa-circle-notch fa-spin text-indigo-500 text-base"></i>
                                        <span>Loading daily report...</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    <script>
        const DAKHA_TIME_ZONE = 'Asia/Dhaka';

        function dhakaDateParts(date = new Date()) {
            const parts = new Intl.DateTimeFormat('en-US', {
                timeZone: DAKHA_TIME_ZONE,
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hourCycle: 'h23',
            }).formatToParts(new Date(date));

            const mapped = {};
            for (const part of parts) {
                if (part.type !== 'literal') mapped[part.type] = part.value;
            }
            return mapped;
        }

        function dhakaMonthYearDate() {
            const parts = dhakaDateParts(new Date());
            return new Date(Number(parts.year), Number(parts.month) - 1, 1);
        }

        async function loadReport() {
            const month = document.getElementById('month-select').value;
            const year = document.getElementById('year-select').value;
            const monthNum = parseInt(month) + 1;

            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/report/summary?month=${monthNum}&year=${year}`);
                const data = await response.json();

                if (data.success) {
                    renderTable(data.data.employees);
                }
            } catch (err) {
                console.error('Failed to load report:', err);
            }
        }

        function renderTable(employees) {
            const tbody = document.getElementById('report-table');

            if (!employees || employees.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="10" class="py-12 text-center text-slate-400">
                            <i class="fa-regular fa-folder-open text-2xl text-slate-300 mb-2 block"></i>
                            <span>No employees found for this period.</span>
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = employees.map(emp => {
                const initial = (emp.name || 'U').charAt(0).toUpperCase();
                const roleBadge = emp.role === 'admin'
                    ? `<span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200/60">Admin</span>`
                    : `<span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-slate-100 text-slate-600">Employee</span>`;

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="py-3.5 px-6">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-indigo-100 text-indigo-700 rounded-full flex items-center justify-center font-bold text-xs shadow-2xs">
                                    ${initial}
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">${emp.name}</div>
                                    <div class="text-[11px] text-slate-400 font-medium">${emp.email}</div>
                                </div>
                                <div class="ml-auto">${roleBadge}</div>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="font-bold text-slate-700">${emp.total_days_worked}</span>
                            <span class="text-[10px] text-slate-400 ml-1">/ ${emp.total_workdays}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="font-semibold text-slate-700">${emp.total_hours_worked}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-emerald-50 text-emerald-700 border-emerald-200">${emp.on_time_days}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-amber-50 text-amber-700 border-amber-200">${emp.late_days}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-rose-50 text-rose-600 border-rose-200">${emp.sick_leaves || 0}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-emerald-50 text-emerald-700 border-emerald-200">${emp.paid_leaves || 0}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-slate-100 text-slate-600 border-slate-200">${emp.unpaid_leaves || 0}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-purple-50 text-purple-700 border-purple-200">${emp.partial_leaves || 0}</span>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-3 py-1 text-xs font-bold rounded-xl border bg-rose-50 text-rose-700 border-rose-200">${emp.absent_days}</span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function filterTable() {
            const input = document.getElementById('search-input').value.toLowerCase();
            const rows = document.querySelectorAll('#report-table tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }

        async function exportReport() {
            const month = document.getElementById('month-select').value;
            const year = document.getElementById('year-select').value;
            const monthNum = parseInt(month) + 1;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/report/export?month=${monthNum}&year=${year}`);
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `monthly_report_${year}-${String(monthNum).padStart(2, '0')}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            } catch (err) {
                console.error('Export failed:', err);
            }
        }

        function dhakaDateStr(date = new Date()) {
            const parts = dhakaDateParts(date);
            return `${parts.year}-${parts.month}-${parts.day}`;
        }

        function formatDhakaTime(value) {
            if (!value) return '—';
            const parts = dhakaDateParts(new Date(value));
            const h = Number(parts.hour);
            const m = parts.minute;
            const ampm = h >= 12 ? 'PM' : 'AM';
            const h12 = h % 12 === 0 ? 12 : h % 12;
            return `${h12}:${m} ${ampm}`;
        }

        let currentDailyView = 'daily';

        function switchView(view) {
            currentDailyView = view;
            const isMonthly = view === 'monthly';

            document.getElementById('monthly-view').classList.toggle('hidden', !isMonthly);
            document.getElementById('daily-view').classList.toggle('hidden', isMonthly);
            document.getElementById('monthly-controls').classList.toggle('hidden', !isMonthly);
            document.getElementById('monthly-export').classList.toggle('hidden', !isMonthly);
            document.getElementById('daily-export').classList.toggle('hidden', isMonthly);

            document.getElementById('report-title').textContent = isMonthly ? 'Monthly Summary' : 'Daily Report';
            document.getElementById('report-subtitle').textContent = isMonthly
                ? 'Complete attendance overview for all employees.'
                : 'Attendance status for every employee on a selected day.';

            if (!isMonthly && !document.getElementById('daily-date').value) {
                document.getElementById('daily-date').value = dhakaDateStr();
            }
            if (!isMonthly) loadDailyReport();
        }

        async function loadDailyReport() {
            const date = document.getElementById('daily-date').value;
            if (!date) return;

            const tbody = document.getElementById('daily-table');
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="py-12 text-center text-slate-400">
                        <div class="inline-flex items-center space-x-2">
                            <i class="fa-solid fa-circle-notch fa-spin text-indigo-500 text-base"></i>
                            <span>Loading daily report...</span>
                        </div>
                    </td>
                </tr>
            `;

            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/report/daily?date=${date}`);
                const data = await response.json();
                if (data.success) {
                    renderDailyReport(data.data);
                } else {
                    throw new Error(data.message || 'Failed to load daily report');
                }
            } catch (err) {
                console.error('Failed to load daily report:', err);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="py-12 text-center text-slate-400">
                            <i class="fa-regular fa-folder-open text-2xl text-slate-300 mb-2 block"></i>
                            <span>Failed to load daily report.</span>
                        </td>
                    </tr>
                `;
            }
        }

        function statusBadge(row) {
            const cls = {
                VERIFIED: 'bg-emerald-50 text-emerald-700 border-emerald-200',
                REJECTED: 'bg-rose-50 text-rose-600 border-rose-200',
                ABSENT: 'bg-rose-50 text-rose-700 border-rose-200',
                ON_LEAVE: 'bg-blue-50 text-blue-700 border-blue-200',
                PARTIAL_LEAVE: 'bg-purple-50 text-purple-700 border-purple-200',
                HOLIDAY: 'bg-slate-100 text-slate-600 border-slate-200',
                WEEKEND: 'bg-slate-100 text-slate-600 border-slate-200',
            };
            const label = {
                VERIFIED: row.is_late ? 'LATE' : 'PRESENT',
                REJECTED: 'REJECTED',
                ABSENT: 'ABSENT',
                ON_LEAVE: 'ON LEAVE',
                PARTIAL_LEAVE: 'PARTIAL',
                HOLIDAY: 'HOLIDAY',
                WEEKEND: 'WEEKEND',
            };
            const icon = {
                VERIFIED: row.is_late ? 'fa-clock' : 'fa-check',
                REJECTED: 'fa-xmark',
                ABSENT: 'fa-user-xmark',
                ON_LEAVE: 'fa-plane',
                PARTIAL_LEAVE: 'fa-hourglass-half',
                HOLIDAY: 'fa-umbrella-beach',
                WEEKEND: 'fa-mug-hot',
            };
            return `<span class="px-3 py-1 text-xs font-bold rounded-xl border inline-flex items-center gap-1.5 ${cls[row.status] || 'bg-slate-100 text-slate-600 border-slate-200'}">
                <i class="fa-solid ${icon[row.status] || 'fa-circle'} text-[10px]"></i>${label[row.status] || row.status}</span>`;
        }

        function renderDailyReport(data) {
            const rows = data.rows || [];
            const kpi = data.kpi || {};

            document.getElementById('daily-count-present').textContent = kpi.present || 0;
            document.getElementById('daily-count-late').textContent = kpi.late || 0;
            document.getElementById('daily-count-absent').textContent = kpi.absent || 0;
            document.getElementById('daily-count-leave').textContent = kpi.on_leave || 0;
            document.getElementById('daily-count-partial').textContent = kpi.partial_leave || 0;
            document.getElementById('daily-count-off').textContent = (kpi.holiday || 0) + (kpi.weekend || 0);
            document.getElementById('daily-report-subtitle').textContent = `Attendance status for ${data.date}`;

            const tbody = document.getElementById('daily-table');
            if (rows.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="py-12 text-center text-slate-400">
                            <i class="fa-regular fa-folder-open text-2xl text-slate-300 mb-2 block"></i>
                            <span>No employees found.</span>
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = rows.map(row => {
                const initial = (row.name || 'U').charAt(0).toUpperCase();
                const lateText = row.is_late ? `${row.late_minutes}m` : '—';
                const leaveLine = row.leave_label
                    ? `<div class="text-[11px] text-indigo-600 font-semibold mt-0.5"><i class="fa-regular fa-hourglass-half mr-1"></i>${row.leave_label}</div>`
                    : '';
                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="py-3.5 px-6">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-indigo-100 text-indigo-700 rounded-full flex items-center justify-center font-bold text-xs shadow-2xs">${initial}</div>
                                <div>
                                    <div class="font-bold text-slate-900 text-sm">${row.name}</div>
                                    <div class="text-[11px] text-slate-400 font-medium">${row.email}</div>
                                    ${leaveLine}
                                </div>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 text-center">${statusBadge(row)}</td>
                        <td class="py-3.5 px-4 text-center font-semibold ${row.is_late ? 'text-amber-600' : 'text-slate-700'}">${formatDhakaTime(row.clock_in_time)}</td>
                        <td class="py-3.5 px-4 text-center font-semibold text-slate-700">${formatDhakaTime(row.clock_out_time)}</td>
                        <td class="py-3.5 px-4 text-center font-mono text-xs text-slate-500">${row.duration || '—'}</td>
                        <td class="py-3.5 px-4 text-center">
                            ${row.is_late
                                ? `<span class="px-3 py-1 text-xs font-bold rounded-xl border bg-amber-50 text-amber-700 border-amber-200">${lateText}</span>`
                                : '<span class="text-slate-300">—</span>'}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function filterDailyTable() {
            const input = document.getElementById('daily-search-input').value.toLowerCase();
            const rows = document.querySelectorAll('#daily-table tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }

        async function exportDailyReport() {
            const date = document.getElementById('daily-date').value;
            if (!date) return;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/report/daily/export?date=${date}`);
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `daily_report_${date}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            } catch (err) {
                console.error('Export failed:', err);
            }
        }

        // Initialize selects to current month/year and load report
        document.addEventListener('DOMContentLoaded', function () {
            const now = dhakaMonthYearDate();
            const monthSelect = document.getElementById('month-select');
            const yearSelect = document.getElementById('year-select');
            monthSelect.value = now.getMonth();
            yearSelect.value = now.getFullYear();
            document.getElementById('daily-date').value = dhakaDateStr();
            switchView('monthly');
            loadReport();
        });
    </script>

