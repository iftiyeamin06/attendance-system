<%- include('partials/layout-header') %>

        <!-- Quick Actions -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            <button onclick="openAddEmployeeModal()"
                class="surface-card p-6 flex items-center space-x-4 text-left hover:border-indigo-300 hover:shadow-md transition group">
                <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center font-bold group-hover:bg-blue-600 group-hover:text-white transition">
                    <i class="fa-solid fa-user-plus text-lg"></i>
                </div>
                <div>
                    <h2 class="text-base font-extrabold text-slate-900">Add New Employee</h2>
                    <p class="text-xs text-slate-400 font-medium">Create employee account with optional device binding</p>
                </div>
                <i class="fa-solid fa-chevron-right ml-auto text-slate-300 group-hover:text-indigo-500 group-hover:translate-x-1 transition"></i>
            </button>

            <button onclick="openAddAdminModal()"
                class="surface-card p-6 flex items-center space-x-4 text-left hover:border-slate-400 hover:shadow-md transition group">
                <div class="w-12 h-12 bg-slate-100 text-slate-900 rounded-2xl flex items-center justify-center font-bold group-hover:bg-slate-900 group-hover:text-white transition">
                    <i class="fa-solid fa-shield-halved text-lg"></i>
                </div>
                <div>
                    <h2 class="text-base font-extrabold text-slate-900">Add New Admin</h2>
                    <p class="text-xs text-slate-400 font-medium">Full system permissions</p>
                </div>
                <i class="fa-solid fa-chevron-right ml-auto text-slate-300 group-hover:text-slate-500 group-hover:translate-x-1 transition"></i>
            </button>
        </div>

        <!-- Add Employee Modal -->
        <div id="add-employee-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-md transition-opacity" onclick="closeAddEmployeeModal()"></div>
            <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-200 max-h-full">
                <!-- Modal Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center font-bold shadow-xs">
                            <i class="fa-solid fa-user-plus text-base"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-extrabold text-slate-900">Add New Employee</h2>
                            <p class="text-xs text-slate-400 font-medium">Create employee account with optional device binding</p>
                        </div>
                    </div>
                    <button onclick="closeAddEmployeeModal()" class="w-8 h-8 bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-xl flex items-center justify-center transition">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="flex-1 overflow-y-auto p-6">
                    <form id="add-employee-form" class="grid grid-cols-1 gap-4">
                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Full Name</label>
                            <div class="relative">
                                <i class="fa-regular fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" id="emp-name" required
                                    class="w-full pl-9 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                                    placeholder="John Doe">
                            </div>
                        </div>

                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Email Address</label>
                            <div class="relative">
                                <i class="fa-regular fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="email" id="emp-email" required
                                    class="w-full pl-9 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                                    placeholder="john@company.com">
                            </div>
                        </div>

                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Temporary Password</label>
                            <div class="relative">
                                <i class="fa-solid fa-key absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" id="emp-password" required
                                    class="w-full pl-9 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                                    placeholder="Pass123!">
                            </div>
                        </div>

                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Device ID (Optional)</label>
                            <div class="relative">
                                <i class="fa-solid fa-mobile-screen absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" id="emp-device"
                                    class="w-full pl-9 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                                    placeholder="Auto-binds on 1st login">
                            </div>
                        </div>

                        <div class="pt-2 grid grid-cols-2 gap-3">
                            <button type="button" onclick="closeAddEmployeeModal()"
                                class="bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition">
                                Cancel
                            </button>
                            <button type="submit"
                                class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition shadow-sm flex items-center justify-center space-x-2">
                                <i class="fa-solid fa-plus"></i>
                                <span>Create Account</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Add Admin Modal -->
        <div id="add-admin-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-md transition-opacity" onclick="closeAddAdminModal()"></div>
            <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-200 max-h-full">
                <!-- Modal Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-slate-100 text-slate-900 rounded-2xl flex items-center justify-center font-bold shadow-xs">
                            <i class="fa-solid fa-shield-halved text-base"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-extrabold text-slate-900">Add New Admin</h2>
                            <p class="text-xs text-slate-400 font-medium">Full system permissions</p>
                        </div>
                    </div>
                    <button onclick="closeAddAdminModal()" class="w-8 h-8 bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-xl flex items-center justify-center transition">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="flex-1 overflow-y-auto p-6">
                    <form id="add-admin-form" class="space-y-4">
                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-1.5">Name</label>
                            <input type="text" id="admin-name" required
                                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                                placeholder="Admin Name">
                        </div>
                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-1.5">Email</label>
                            <input type="email" id="admin-email" required
                                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                                placeholder="admin@company.com">
                        </div>
                        <div>
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-1.5">Password</label>
                            <input type="text" id="admin-password" required
                                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                                placeholder="AdminPass123">
                        </div>
                        <div class="pt-2 grid grid-cols-2 gap-3">
                            <button type="button" onclick="closeAddAdminModal()"
                                class="bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition">
                                Cancel
                            </button>
                            <button type="submit"
                                class="bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 rounded-xl text-xs uppercase tracking-wider transition shadow-sm flex items-center justify-center space-x-2">
                                <i class="fa-solid fa-user-shield"></i>
                                <span>Create Administrator</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Bind Device Modal -->
        <div id="bind-device-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-md transition-opacity" onclick="closeBindModal()"></div>
            <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-200 max-h-full">
                <!-- Modal Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center font-bold shadow-xs">
                            <i class="fa-solid fa-mobile-screen text-base"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-extrabold text-slate-900">Bind Device</h2>
                            <p class="text-xs text-slate-400 font-medium">Link <span id="bind-employee-name" class="font-bold text-slate-600">Employee</span> to a device</p>
                        </div>
                    </div>
                    <button onclick="closeBindModal()" class="w-8 h-8 bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-xl flex items-center justify-center transition">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="flex-1 overflow-y-auto p-6 space-y-4">
                    <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 text-xs space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-slate-400 font-semibold uppercase tracking-wider">Currently Bound</span>
                            <span id="bind-current-device" class="font-mono font-bold text-sm text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md">Loading...</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-slate-400 font-semibold uppercase tracking-wider">Active Session Device</span>
                            <span id="bind-active-device" class="text-sm text-slate-400 font-medium">Loading...</span>
                        </div>
                    </div>

                    <!-- Option A -->
                    <button id="bind-from-active-btn" onclick="bindFromActiveSession()"
                        class="w-full bg-indigo-600 hover:bg-indigo-700 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold px-4 py-3.5 rounded-xl text-sm transition shadow-sm flex items-center space-x-3">
                        <div class="w-9 h-9 bg-white/15 rounded-lg flex items-center justify-center">
                            <i class="fa-solid fa-link text-xs"></i>
                        </div>
                        <div class="text-left">
                            <span class="block font-extrabold">Bind Active Session Device</span>
                            <span class="block text-[11px] text-indigo-100 font-semibold">Locks the UUID currently in the active clock-in</span>
                        </div>
                    </button>

                    <!-- Option B -->
                    <button id="bind-reset-auto-btn" onclick="resetAndAllowAutoBind()"
                        class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 font-bold px-4 py-3.5 rounded-xl text-sm transition flex items-center space-x-3">
                        <div class="w-9 h-9 bg-white rounded-lg flex items-center justify-center text-slate-500 border border-slate-200">
                            <i class="fa-solid fa-rotate-left text-xs"></i>
                        </div>
                        <div class="text-left">
                            <span class="block font-extrabold">Reset & Allow Auto-Bind</span>
                            <span class="block text-[11px] text-slate-400 font-semibold">Employee's next clock-in auto-locks their browser device</span>
                        </div>
                    </button>

                    <div class="flex items-center space-x-3 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                        <div class="h-px flex-1 bg-slate-200"></div>
                        <span>Or Manually</span>
                        <div class="h-px flex-1 bg-slate-200"></div>
                    </div>

                    <div class="flex space-x-2">
                        <input type="text" id="bind-manual-device" placeholder="Enter device UUID..."
                            class="flex-1 px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                        <button onclick="bindManualDevice()"
                            class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition shadow-sm flex items-center space-x-1.5">
                            <i class="fa-solid fa-link text-[10px]"></i>
                            <span>Bind</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reset Password Modal -->
        <div id="reset-password-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-md transition-opacity" onclick="closeResetModal()"></div>
            <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-200 max-h-full">
                <!-- Modal Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center font-bold shadow-xs">
                            <i class="fa-solid fa-key text-base"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-extrabold text-slate-900">Reset Password</h2>
                            <p class="text-xs text-slate-400 font-medium">Link <span id="rp-employee-name" class="font-bold text-slate-600">Employee</span> to a new password</p>
                        </div>
                    </div>
                    <button onclick="closeResetModal()" class="w-8 h-8 bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-xl flex items-center justify-center transition">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="flex-1 overflow-y-auto p-6">
                    <div id="rp-form">
                        <div class="space-y-2 mb-5">
                            <label class="flex items-start space-x-2.5 cursor-pointer">
                                <input type="radio" name="rp-mode" value="generate" checked onclick="toggleResetMode()"
                                    class="mt-0.5 accent-amber-600">
                                <span>
                                    <span class="block text-sm font-bold text-slate-800">Generate temporary password</span>
                                    <span class="block text-xs text-slate-400 font-medium">A strong password is created for you. Show it to the employee — they must change it on next login.</span>
                                </span>
                            </label>
                            <label class="flex items-start space-x-2.5 cursor-pointer">
                                <input type="radio" name="rp-mode" value="custom" onclick="toggleResetMode()"
                                    class="mt-0.5 accent-amber-600">
                                <span>
                                    <span class="block text-sm font-bold text-slate-800">Set a custom password</span>
                                    <span class="block text-xs text-slate-400 font-medium">Type the new password yourself (min 8 characters).</span>
                                </span>
                            </label>
                        </div>

                        <div class="mb-5 hidden" id="rp-custom-wrap">
                            <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">New Password</label>
                            <div class="relative">
                                <i class="fa-solid fa-key absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" id="rp-custom-password"
                                    class="w-full pl-9 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-amber-500 focus:bg-white transition"
                                    placeholder="At least 8 characters">
                            </div>
                        </div>

                        <div class="bg-amber-50 border border-amber-200/60 rounded-xl p-3.5 text-xs text-amber-700 font-semibold mb-5 flex items-start space-x-2">
                            <i class="fa-solid fa-circle-exclamation mt-0.5"></i>
                            <span>The employee will be forced to change this password the first time they sign in.</span>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <button type="button" onclick="closeResetModal()"
                                class="bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition">
                                Cancel
                            </button>
                            <button type="button" onclick="submitResetPassword()" id="rp-submit-btn"
                                class="bg-amber-600 hover:bg-amber-700 text-white font-bold px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition shadow-sm flex items-center justify-center space-x-2">
                                <i class="fa-solid fa-key"></i>
                                <span>Reset Password</span>
                            </button>
                        </div>
                    </div>

                    <div id="rp-result" class="hidden">
                        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl mb-5 text-xs font-semibold flex items-center space-x-2">
                            <i class="fa-solid fa-circle-check text-emerald-500"></i>
                            <span>Password reset. The employee must change it on their next login.</span>
                        </div>

                        <div id="rp-generated-wrap" class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-5">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">Temporary Password</p>
                            <div class="flex items-center space-x-2">
                                <code id="rp-generated" class="flex-1 bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm font-mono font-bold text-slate-800 break-all select-all"></code>
                                <button onclick="copyTemporaryPassword()" class="bg-slate-900 hover:bg-slate-800 text-white rounded-lg px-3 py-2 text-xs font-bold transition" title="Copy">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                        </div>

                        <button type="button" onclick="closeResetModal()"
                            class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 rounded-xl text-xs uppercase tracking-wider transition shadow-sm">
                            Done
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Management Table -->
        <div class="surface-card overflow-hidden mb-8">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between flex-wrap gap-4 bg-slate-50/50">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold">
                        <i class="fa-solid fa-users-gear text-sm"></i>
                    </div>
                    <div>
                        <h2 class="text-base font-extrabold text-slate-900">User Directory</h2>
                        <p class="text-xs text-slate-500 font-medium">Manage accounts and device bindings</p>
                    </div>
                </div>
                <button onclick="exportCsv()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-xl text-xs transition shadow-sm flex items-center space-x-2">
                    <i class="fa-solid fa-file-csv text-sm"></i>
                    <span>Export Attendance CSV</span>
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px] text-left text-sm">
                    <thead class="bg-slate-50/80 border-b border-slate-100 text-[11px] uppercase tracking-wider font-extrabold text-slate-400">
                        <tr>
                            <th class="py-3.5 px-6">User</th>
                            <th class="py-3.5 px-4">Email</th>
                            <th class="py-3.5 px-4">Role</th>
                            <th class="py-3.5 px-4">Device Bound</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="employees-table" class="divide-y divide-slate-100">
                        <tr>
                            <td colspan="5" class="py-12 text-center text-slate-400">
                                <i class="fa-solid fa-circle-notch fa-spin text-indigo-500 text-base mr-2"></i>
                                <span>Loading users...</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Employee Monthly Summary Modal -->
        <div id="employee-modal" class="fixed inset-0 z-50 hidden">
            <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-md transition-opacity" onclick="closeModal()"></div>
            <div class="absolute inset-4 md:inset-8 lg:inset-12 bg-white rounded-3xl shadow-2xl flex flex-col overflow-hidden border border-slate-200">
                <!-- Modal Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/80">
                    <div class="flex items-center space-x-3">
                        <div id="modal-avatar" class="w-10 h-10 bg-indigo-600 text-white rounded-2xl flex items-center justify-center font-bold text-base shadow-sm">
                            E
                        </div>
                        <div>
                            <h2 id="modal-employee-name" class="text-base font-extrabold text-slate-900"></h2>
                            <p id="modal-employee-email" class="text-xs text-slate-400 font-medium"></p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        <select id="modal-month" class="px-3.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-2xs"></select>
                        <button onclick="closeModal()" class="w-8 h-8 bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-xl flex items-center justify-center transition">
                            <i class="fa-solid fa-xmark text-sm"></i>
                        </button>
                    </div>
                </div>

                <!-- Modal Body -->
                <div class="flex-1 overflow-y-auto p-6 space-y-6">
                    <div id="modal-loading" class="text-center py-16 text-slate-400">
                        <i class="fa-solid fa-circle-notch fa-spin text-indigo-500 text-2xl mb-2"></i>
                        <p class="text-xs font-semibold">Loading employee report...</p>
                    </div>

                    <div id="modal-content" class="hidden space-y-6">
                        <!-- Key Stats Grid -->
                        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                            <div class="bg-emerald-50/80 border border-emerald-200/60 rounded-2xl p-3.5 text-center">
                                <p class="text-2xl font-extrabold text-emerald-700" id="m-present">0</p>
                                <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider mt-0.5">Present</p>
                            </div>
                            <div class="bg-amber-50/80 border border-amber-200/60 rounded-2xl p-3.5 text-center">
                                <p class="text-2xl font-extrabold text-amber-700" id="m-late">0</p>
                                <p class="text-xs font-bold text-amber-600 uppercase tracking-wider mt-0.5">Late</p>
                            </div>
                            <div class="bg-blue-50/80 border border-blue-200/60 rounded-2xl p-3.5 text-center">
                                <p class="text-2xl font-extrabold text-blue-700" id="m-leave">0</p>
                                <p class="text-xs font-bold text-blue-600 uppercase tracking-wider mt-0.5">On Leave</p>
                            </div>
                            <div class="bg-slate-100 border border-slate-200 rounded-2xl p-3.5 text-center">
                                <p class="text-2xl font-extrabold text-slate-700" id="m-absent">0</p>
                                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mt-0.5">Absent</p>
                            </div>
                            <div class="bg-indigo-50/80 border border-indigo-200/60 rounded-2xl p-3.5 text-center col-span-2 md:col-span-1">
                                <p class="text-2xl font-extrabold text-indigo-700" id="m-rate">0%</p>
                                <p class="text-xs font-bold text-indigo-600 uppercase tracking-wider mt-0.5">Rate</p>
                            </div>
                        </div>

                        <!-- Secondary Metrics -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                            <div class="bg-white border border-slate-200/80 rounded-2xl p-3.5 text-center shadow-2xs">
                                <p class="text-base font-extrabold text-slate-900" id="m-hours">0h 0m</p>
                                <p class="text-[11px] font-medium text-slate-400">Hours Worked</p>
                            </div>
                            <div class="bg-white border border-slate-200/80 rounded-2xl p-3.5 text-center shadow-2xs">
                                <p class="text-base font-extrabold text-amber-600" id="m-late-min">0 min</p>
                                <p class="text-[11px] font-medium text-slate-400">Total Late Time</p>
                            </div>
                            <div class="bg-white border border-slate-200/80 rounded-2xl p-3.5 text-center shadow-2xs">
                                <p class="text-base font-extrabold text-indigo-600" id="m-partial">0</p>
                                <p class="text-[11px] font-medium text-slate-400">Partial Days</p>
                            </div>
                        </div>

                        <!-- Attendance Chart Container -->
                        <div class="bg-slate-50/80 border border-slate-200/80 rounded-2xl p-4">
                            <div class="flex justify-between items-center mb-3">
                                <p class="text-xs font-bold text-slate-600 uppercase tracking-wider">Attendance Distribution</p>
                                <div class="flex items-center space-x-3 text-[10px] font-bold">
                                    <span class="flex items-center space-x-1 text-emerald-600"><span class="w-2 h-2 bg-emerald-400 rounded-full"></span><span>Verified</span></span>
                                    <span class="flex items-center space-x-1 text-amber-600"><span class="w-2 h-2 bg-amber-400 rounded-full"></span><span>Late</span></span>
                                    <span class="flex items-center space-x-1 text-blue-600"><span class="w-2 h-2 bg-blue-400 rounded-full"></span><span>Leave</span></span>
                                </div>
