                            <div id="m-chart" class="flex items-end space-x-1 h-16 pt-2"></div>
                            <div class="flex items-center justify-between mt-2 text-[11px] font-medium text-slate-400">
                                <span id="m-chart-start"></span>
                                <span id="m-chart-end"></span>
                            </div>
                        </div>

                        <!-- Daily Breakdown Table -->
                        <div class="bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-2xs">
                            <div class="px-4 py-3 bg-slate-50/80 border-b border-slate-100">
                                <p class="text-xs font-bold text-slate-600 uppercase tracking-wider">Daily Log Breakdown</p>
                            </div>
                            <div id="m-daily" class="divide-y divide-slate-100 max-h-72 overflow-y-auto"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

<%- include('partials/layout-footer') %>

    <script>
        let currentEmployeeId = null;
        const DAKHA_TIME_ZONE = 'Asia/Dhaka';

        function dhakaDateParts(date = new Date()) {
            const parts = new Intl.DateTimeFormat('en-US', {
                timeZone: DAKHA_TIME_ZONE,
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hourCycle: 'h23',
            }).formatToParts(new Date(date));

            const mapped = {};
            for (const part of parts) {
                if (part.type !== 'literal') mapped[part.type] = part.value;
            }
            return mapped;
        }

        function dhakaMonthYearDate() {
            const parts = dhakaDateParts(new Date());
            return new Date(Number(parts.year), Number(parts.month) - 1, 1);
        }

        function formatDhakaMonthLabel(date) {
            return new Intl.DateTimeFormat('en-US', {
                timeZone: DAKHA_TIME_ZONE,
                month: 'long',
                year: 'numeric',
            }).format(new Date(date));
        }

        function dhakaDateInputValue() {
            const parts = dhakaDateParts(new Date());
            return `${parts.year}-${parts.month}-${parts.day}`;
        }

        async function loadEmployees() {
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users`);
                const data = await response.json();
                const employeesTable = document.getElementById('employees-table');

                employeesTable.innerHTML = data.data.map(emp => {
                    const initial = (emp.name || 'U').charAt(0).toUpperCase();
                    const isBound = !!emp.bound_device_id;
                    const roleBadge = emp.role === 'admin'
                        ? `<span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-indigo-50 text-indigo-700 border border-indigo-200/60 inline-flex items-center space-x-1"><i class="fa-solid fa-shield-halved text-[10px]"></i><span>Admin</span></span>`
                        : `<span class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-100 text-slate-600 border border-slate-200">Employee</span>`;

                    const deviceBadge = isBound
                        ? `<span class="font-mono text-xs bg-emerald-50 text-emerald-700 border border-emerald-200/60 px-2.5 py-1 rounded-lg inline-flex items-center space-x-1 font-semibold"><i class="fa-solid fa-mobile-screen-button text-xs"></i><span>${emp.bound_device_id.substring(0, 14)}...</span></span>`
                        : `<span class="text-slate-400 text-xs italic font-medium"><i class="fa-regular fa-circle-xmark mr-1 text-slate-300"></i>Unbound</span>`;

                    return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="py-3.5 px-6">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 ${emp.role === 'admin' ? 'bg-indigo-600 text-white' : 'bg-slate-200 text-slate-700'} rounded-full flex items-center justify-center font-bold text-xs shadow-2xs">
                                    ${initial}
                                </div>
                                <span class="font-bold text-slate-900 cursor-pointer hover:text-indigo-600 transition" onclick="openModal('${emp.id}')">${emp.name}</span>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 font-medium text-slate-600">${emp.email}</td>
                        <td class="py-3.5 px-4">${roleBadge}</td>
                        <td class="py-3.5 px-4">${deviceBadge}</td>
                        <td class="py-3.5 px-6 text-right">
                            <div class="flex items-center justify-end space-x-2">
                                ${emp.role !== 'admin' ? `
                                <button onclick="openBindModal('${emp.id}')" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200/60 px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center space-x-1" title="Bind device from active session or reset for auto-bind">
                                    <i class="fa-solid fa-link text-[10px]"></i>
                                    <span>Bind</span>
                                </button>
                                ${emp.bound_device_id
                                    ? `<button onclick="resetDevice('${emp.id}')" class="bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 border border-slate-200 hover:border-rose-200 px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center space-x-1">
                                        <i class="fa-solid fa-rotate-left text-[10px]"></i>
                                        <span>Reset</span>
                                       </button>`
                                    : ''
                                }
                                <button onclick="openResetModal('${emp.id}', '${emp.name.replace(/'/g, "\\'")}')" class="bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200/60 px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center space-x-1" title="Reset password and force change on next login">
                                    <i class="fa-solid fa-key text-[10px]"></i>
                                    <span>Reset PW</span>
                                </button>
                                ` : ''}
                                <button onclick="deleteUser('${emp.id}', '${emp.name.replace(/'/g, "\\'")}', '${emp.role}')" class="bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200/60 px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center space-x-1" title="Delete ${emp.role}">
                                    <i class="fa-regular fa-trash-can text-[10px]"></i>
                                    <span>Delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                `}).join('');
            } catch (err) {
                console.error(err);
            }
        }

        async function deleteUser(userId, userName, role) {
            if (!confirm(`Are you sure you want to delete ${role} "${userName}"? This will permanently remove all associated records.`)) return;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users/${userId}`, { method: 'DELETE' });
                const data = await response.json();
                if (data.success) {
                    showMessage(`${role === 'admin' ? 'Admin' : 'Employee'} deleted successfully`, 'success');
                    loadEmployees();
                } else {
                    showMessage(data.message || 'Failed to delete user', 'error');
                }
            } catch (err) {
                console.error(err);
                showMessage('Error deleting user', 'error');
            }
        }

        let bindUserId = null;

        function openBindModal(userId) {
            bindUserId = userId;
            document.getElementById('bind-device-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            loadDeviceBindingInfo(userId);
        }

        function closeBindModal() {
            document.getElementById('bind-device-modal').classList.add('hidden');
            document.body.style.overflow = '';
            bindUserId = null;
        }

        async function loadDeviceBindingInfo(userId) {
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users/${userId}/device-binding`);
                const data = await response.json();
                if (!data.success) {
                    throw new Error(data.message || 'Failed to load device info');
                }

                const d = data.data;
                const empNameEl = document.getElementById('bind-employee-name');
                const boundEl = document.getElementById('bind-current-device');
                const activeEl = document.getElementById('bind-active-device');
                const activeBtn = document.getElementById('bind-from-active-btn');
                const autoBtn = document.getElementById('bind-reset-auto-btn');

                empNameEl.textContent = d.name || 'Employee';
                boundEl.textContent = d.bound_device_id
                    ? `${d.bound_device_id.substring(0, 20)}...`
                    : 'Not bound';
                boundEl.className = 'font-mono font-bold text-sm ' + (d.bound_device_id ? 'text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md' : 'text-slate-400 bg-slate-100 px-2 py-0.5 rounded-md');

                if (d.has_active_session && d.active_session_device_id) {
                    activeEl.textContent = `${d.active_session_device_id.substring(0, 20)}...`;
                    activeEl.className = 'font-mono font-bold text-sm text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-md';
                    activeBtn.disabled = false;
                    activeBtn.title = `Bind from active clock-in device (${d.active_session_device_id})`;
                } else {
                    activeEl.textContent = 'No active clock-in session';
                    activeEl.className = 'text-sm text-slate-400 font-medium';
                    activeBtn.disabled = true;
                    activeBtn.title = 'Employee has no active clock-in session';
                }

                autoBtn.disabled = false;
            } catch (err) {
                console.error(err);
                alert('Failed to load device binding info.');
            }
        }

        async function bindFromActiveSession() {
            if (!bindUserId) return;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users/${bindUserId}/bind-device`, {
                    method: 'POST',
                    body: JSON.stringify({}),
                });
                const data = await response.json();
                if (data.success) {
                    showMessage(data.message || 'Device bound from active session', 'success');
                    closeBindModal();
                    loadEmployees();
                } else {
                    alert(data.message || 'Failed to bind device from active session.');
                }
            } catch (err) { console.error(err); }
        }

        async function resetAndAllowAutoBind() {
            if (!bindUserId) return;
            if (!confirm('Reset the device binding? The employee\u2019s next clock-in will automatically bind their current browser device to their account.')) return;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users/${bindUserId}/reset-device`, { method: 'POST' });
                const data = await response.json();
                if (data.success) {
                    showMessage('Device binding reset. Next clock-in will auto-bind.', 'success');
                    closeBindModal();
                    loadEmployees();
                } else {
                    alert(data.message || 'Failed to reset device binding.');
                }
            } catch (err) { console.error(err); }
        }

        async function bindManualDevice() {
            const input = document.getElementById('bind-manual-device');
            const deviceId = input.value.trim();
            if (!deviceId) { alert('Enter a device ID to bind.'); return; }
            if (!bindUserId) return;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users/${bindUserId}/bind-device`, {
                    method: 'POST',
                    body: JSON.stringify({ device_id: deviceId }),
                });
                const data = await response.json();
                if (data.success) {
                    showMessage('Device bound successfully', 'success');
                    closeBindModal();
                    loadEmployees();
                } else {
                    alert(data.message || 'Failed to bind device.');
                }
            } catch (err) { console.error(err); }
        }

        async function resetDevice(userId) {
            if (!confirm('Are you sure you want to reset the device binding for this user?')) return;
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users/${userId}/reset-device`, { method: 'POST' });
                const data = await response.json();
                if (data.success) {
                    showMessage('Device binding reset successfully', 'success');
                    loadEmployees();
                } else {
                    showMessage(data.message || 'Failed to reset device binding', 'error');
                }
            } catch (err) { console.error(err); }
        }

        let resetUserId = null;
        let lastGeneratedPassword = '';

        function openResetModal(userId, name) {
            resetUserId = userId;
            lastGeneratedPassword = '';
            document.getElementById('rp-employee-name').textContent = name || 'Employee';
            document.getElementById('rp-form').classList.remove('hidden');
            document.getElementById('rp-result').classList.add('hidden');
            document.getElementById('rp-custom-password').value = '';
            document.querySelector('input[name="rp-mode"][value="generate"]').checked = true;
            toggleResetMode();
            document.getElementById('reset-password-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeResetModal() {
            document.getElementById('reset-password-modal').classList.add('hidden');
            document.body.style.overflow = '';
            resetUserId = null;
        }

        function toggleResetMode() {
            const mode = document.querySelector('input[name="rp-mode"]:checked').value;
            document.getElementById('rp-custom-wrap').classList.toggle('hidden', mode !== 'custom');
        }

        async function submitResetPassword() {
            if (!resetUserId) return;
            const mode = document.querySelector('input[name="rp-mode"]:checked').value;
            const customPassword = document.getElementById('rp-custom-password').value;

            if (mode === 'custom' && customPassword.length < 8) {
                alert('Custom password must be at least 8 characters long.');
                return;
            }

            const btn = document.getElementById('rp-submit-btn');
            btn.disabled = true;
            btn.querySelector('span').textContent = 'Resetting...';

            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users/${resetUserId}/reset-password`, {
                    method: 'POST',
                    body: JSON.stringify(mode === 'custom' ? { password: customPassword } : {}),
                });
                const data = await response.json();

                if (!data.success) {
                    alert(data.message || 'Failed to reset password.');
                    return;
                }

                lastGeneratedPassword = data.temporary_password || '';
                document.getElementById('rp-form').classList.add('hidden');
                document.getElementById('rp-result').classList.remove('hidden');

                if (lastGeneratedPassword) {
                    document.getElementById('rp-generated').textContent = lastGeneratedPassword;
                    document.getElementById('rp-generated-wrap').classList.remove('hidden');
                } else {
                    document.getElementById('rp-generated-wrap').classList.add('hidden');
                }
            } catch (err) {
                console.error(err);
                alert('Error resetting password.');
            } finally {
                btn.disabled = false;
                btn.querySelector('span').textContent = 'Reset Password';
            }
        }

        function copyTemporaryPassword() {
            if (!lastGeneratedPassword) return;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(lastGeneratedPassword).then(() => {
                    showMessage('Temporary password copied', 'success');
                });
            } else {
                const el = document.getElementById('rp-generated');
                const range = document.createRange();
                range.selectNodeContents(el);
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(range);
                document.execCommand('copy');
                sel.removeAllRanges();
                showMessage('Temporary password copied', 'success');
            }
        }

        document.getElementById('add-employee-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const body = {
                name: document.getElementById('emp-name').value.trim(),
                email: document.getElementById('emp-email').value.trim(),
                password: document.getElementById('emp-password').value,
                device_id: document.getElementById('emp-device').value.trim() || undefined,
            };
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/users`, { method: 'POST', body: JSON.stringify(body) });
                const data = await response.json();
                if (data.success) {
                    showMessage('Employee created successfully', 'success');
                    e.target.reset();
                    closeAddEmployeeModal();
                    loadEmployees();
                } else {
                    alert(data.message || 'Failed to create employee');
                }
            } catch (err) { console.error(err); }
        });

        document.getElementById('add-admin-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const body = {
                name: document.getElementById('admin-name').value.trim(),
                email: document.getElementById('admin-email').value.trim(),
                password: document.getElementById('admin-password').value,
            };
            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/admins`, { method: 'POST', body: JSON.stringify(body) });
                const data = await response.json();
                if (data.success) {
                    showMessage('Admin created successfully', 'success');
                    e.target.reset();
                    closeAddAdminModal();
                    loadEmployees();
                } else {
                    alert(data.message || 'Failed to create admin');
                }
            } catch (err) { console.error(err); }
        });

        async function exportCsv() {
            try {
                const token = await getStoredToken();
                const response = await fetch(`${API_BASE}/admin/export`, { headers: { 'Authorization': `Bearer ${token}` } });
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `attendance_export_${dhakaDateInputValue()}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            } catch (err) { console.error('Export failed:', err); }
        }

        async function openModal(employeeId) {
            currentEmployeeId = employeeId;
            const modal = document.getElementById('employee-modal');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';

            populateMonthSelector();
            await loadEmployeeSummary(employeeId);
        }

        function closeModal() {
            document.getElementById('employee-modal').classList.add('hidden');
            document.body.style.overflow = '';
            currentEmployeeId = null;
        }

        function openAddEmployeeModal() {
            document.getElementById('add-employee-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            document.getElementById('emp-name').focus();
        }

        function closeAddEmployeeModal() {
            document.getElementById('add-employee-modal').classList.add('hidden');
            document.body.style.overflow = '';
        }

        function openAddAdminModal() {
            document.getElementById('add-admin-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            document.getElementById('admin-name').focus();
        }

        function closeAddAdminModal() {
            document.getElementById('add-admin-modal').classList.add('hidden');
            document.body.style.overflow = '';
        }

        function populateMonthSelector() {
            const select = document.getElementById('modal-month');
            select.innerHTML = '';
            const now = dhakaMonthYearDate();
            for (let i = 0; i < 12; i++) {
                const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                const val = `${d.getMonth() + 1}:${d.getFullYear()}`;
                const label = formatDhakaMonthLabel(d);
                const opt = document.createElement('option');
                opt.value = val;
                opt.textContent = label;
                if (i === 0) opt.selected = true;
                select.appendChild(opt);
            }
        }

        async function loadEmployeeSummary(employeeId) {
            const loading = document.getElementById('modal-loading');
            const content = document.getElementById('modal-content');
            loading.classList.remove('hidden');
            content.classList.add('hidden');

            const [month, year] = document.getElementById('modal-month').value.split(':');

            try {
                const response = await fetchWithAuth(`${API_BASE}/admin/employee/${employeeId}/summary?month=${month}&year=${year}`);
                const data = await response.json();
                if (!data.success) throw new Error(data.message);

                const emp = data.data.employee;
                const s = data.data.summary;

                document.getElementById('modal-employee-name').textContent = emp.name;
                document.getElementById('modal-employee-email').textContent = emp.email;
                document.getElementById('modal-avatar').textContent = (emp.name || 'E').charAt(0).toUpperCase();

                document.getElementById('m-present').textContent = s.present;
                document.getElementById('m-late').textContent = s.late;
                document.getElementById('m-leave').textContent = s.on_leave;
                document.getElementById('m-absent').textContent = s.absent;
                document.getElementById('m-rate').textContent = s.attendance_rate + '%';
                document.getElementById('m-hours').textContent = s.total_hours_worked;
                document.getElementById('m-late-min').textContent = s.total_late_minutes + ' min';
                document.getElementById('m-partial').textContent = s.partial_leave_days;

                renderChart(data.data.daily_breakdown);
                renderDailyBreakdown(data.data.daily_breakdown);

                loading.classList.add('hidden');
                content.classList.remove('hidden');
            } catch (err) {
                loading.innerHTML = '<p class="text-rose-500 font-semibold">Failed to load employee summary.</p>';
                console.error(err);
            }
        }

        function renderChart(days) {
            const chart = document.getElementById('m-chart');
            chart.innerHTML = '';
            if (days.length === 0) return;

            days.forEach(day => {
                const bar = document.createElement('div');
                let color = 'bg-slate-200';
                if (day.status === 'VERIFIED') color = 'bg-emerald-400';
                else if (day.status === 'LATE') color = 'bg-amber-400';
                else if (day.status === 'ON_LEAVE') color = 'bg-blue-400';
                else if (day.status === 'ABSENT') color = 'bg-rose-200';

                bar.className = `flex-1 ${color} rounded-sm min-w-[4px] transition-all hover:opacity-80`;
                bar.title = `${day.date} (${day.day}): ${day.status}`;
                bar.style.height = day.status === 'ABSENT' ? '20%' : '100%';
                chart.appendChild(bar);
            });

            if (days.length > 0) {
                document.getElementById('m-chart-start').textContent = days[0].date;
                document.getElementById('m-chart-end').textContent = days[days.length - 1].date;
            }
        }

        function renderDailyBreakdown(days) {
            const container = document.getElementById('m-daily');
            if (days.length === 0) {
                container.innerHTML = '<p class="py-6 text-center text-slate-400 text-xs">No daily record found for this month.</p>';
                return;
            }

            container.innerHTML = days.map(day => {
                let badgeClass = 'badge-pill badge-neutral';
                if (day.status === 'VERIFIED') badgeClass = 'badge-pill badge-present';
                else if (day.status === 'LATE') badgeClass = 'badge-pill badge-late';
                else if (day.status === 'ON_LEAVE') badgeClass = 'badge-pill badge-leave';
                else if (day.status === 'ABSENT') badgeClass = 'badge-pill badge-absent';

                let detail = '';
                if (day.clock_in) {
                    detail = `<span class="font-semibold text-slate-700">${day.clock_in}</span>`;
                    if (day.clock_out) detail += ` <span class="text-slate-300">-</span> <span class="font-semibold text-slate-700">${day.clock_out}</span>`;
                    if (day.duration) detail += ` <span class="text-slate-400 ml-1">(${day.duration})</span>`;
                } else if (day.leave_type) {
                    detail = `<span class="text-blue-600 font-semibold capitalize">${day.leave_type} Leave</span>`;
                } else if (day.status === 'ABSENT') {
                    detail = '<span class="text-rose-400 italic">No Clock In</span>';
                }

                let lateTag = '';
                if (day.is_late) {
                    lateTag = `<span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-amber-100 text-amber-700 ml-1">Late ${day.late_minutes}m</span>`;
                }

                return `
                    <div class="flex items-center justify-between px-4 py-3 hover:bg-slate-50 transition">
                        <div class="flex items-center space-x-3 min-w-0">
                            <div class="w-14 text-xs font-bold text-slate-400">${day.day}</div>
                            <div class="text-xs font-bold text-slate-800">${day.date.split('-').slice(1).join('/')}</div>
                            ${lateTag}
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="text-xs text-right">${detail}</div>
                            <span class="${badgeClass}">${day.status}</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        document.getElementById('modal-month').addEventListener('change', () => {
            if (currentEmployeeId) loadEmployeeSummary(currentEmployeeId);
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                if (!document.getElementById('employee-modal').classList.contains('hidden')) closeModal();
                if (!document.getElementById('add-employee-modal').classList.contains('hidden')) closeAddEmployeeModal();
                if (!document.getElementById('add-admin-modal').classList.contains('hidden')) closeAddAdminModal();
                if (!document.getElementById('bind-device-modal').classList.contains('hidden')) closeBindModal();
                if (!document.getElementById('reset-password-modal').classList.contains('hidden')) closeResetModal();
            }
        });

        loadEmployees();
    </script>
