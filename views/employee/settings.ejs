<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings - Attendance System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 text-slate-600 min-h-screen flex flex-col">
    <!-- Navbar -->
    <nav class="sticky top-0 z-40 glass-nav">
        <div class="max-w-xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 bg-slate-900 rounded-xl flex items-center justify-center text-white">
                    <i class="fa-solid fa-clock-rotate-left text-base"></i>
                </div>
                <div class="leading-tight">
                    <span class="text-sm font-bold text-slate-900 tracking-tight">Attendance</span>
                    <p class="text-[11px] text-slate-400 font-medium hidden sm:block">Account Settings</p>
                </div>
            </div>

            <div class="flex items-center space-x-3">
                <a href="/employee/dashboard" class="text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:border-slate-300 px-3 py-2 rounded-lg transition shadow-sm flex items-center space-x-1">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/logout" class="text-xs font-semibold text-slate-500 hover:text-rose-600 bg-white border border-slate-200 hover:border-rose-200 px-3 py-2 rounded-lg transition shadow-sm">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="max-w-xl mx-auto px-4 py-8 flex-1 w-full space-y-6">
        <div id="status-message"></div>

        <div class="surface-card p-6 sm:p-8">
            <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
                <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold">
                    <i class="fa-solid fa-key text-base"></i>
                </div>
                <div>
                    <h2 class="text-lg font-extrabold text-slate-900 tracking-tight">Change Password</h2>
                    <p class="text-xs text-slate-400 font-medium">Update your employee security credentials</p>
                </div>
            </div>

            <form id="change-password-form" class="space-y-5">
                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Current Password</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="password" id="current-password" required
                            class="w-full pl-9 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                            placeholder="Enter current password">
                    </div>
                </div>

                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">New Password</label>
                    <div class="relative">
                        <i class="fa-solid fa-shield-halved absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="password" id="new-password" required minlength="6"
                            class="w-full pl-9 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                            placeholder="Enter new password (min 6 chars)">
                    </div>
                </div>

                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Confirm New Password</label>
                    <div class="relative">
                        <i class="fa-solid fa-check-double absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="password" id="confirm-password" required
                            class="w-full pl-9 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                            placeholder="Re-enter new password">
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit"
                        class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all duration-200 text-sm flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Update Password</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mt-auto py-6 border-t border-slate-200/80 bg-white/60">
        <div class="max-w-xl mx-auto px-4 text-center text-xs text-slate-400 font-medium">
            <p>&copy; <%= new Date().getFullYear() %> Attendance Management System.</p>
        </div>
    </footer>

    <script>
        const API_BASE = '/api';
        const AUTH_TOKEN = '<%= token || "" %>';

        async function getStoredToken() {
            if (AUTH_TOKEN && AUTH_TOKEN !== '') {
                return AUTH_TOKEN;
            }
            return localStorage.getItem('token');
        }

        async function fetchWithAuth(url, options = {}) {
            const token = await getStoredToken();
            const headers = {
                'Content-Type': 'application/json',
                ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
                ...options.headers,
            };
            const response = await fetch(url, { ...options, headers });
            return response;
        }

        function showMessage(msg, type = 'info') {
            const container = document.getElementById('status-message');
            const icons = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500 text-base mr-2"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500 text-base mr-2"></i>',
                info: '<i class="fa-solid fa-circle-info text-blue-500 text-base mr-2"></i>',
            };
            const styles = {
                success: 'bg-emerald-50/90 border-emerald-200 text-emerald-800 shadow-sm',
                error: 'bg-rose-50/90 border-rose-200 text-rose-800 shadow-sm',
                info: 'bg-blue-50/90 border-blue-200 text-blue-800 shadow-sm',
            };
            container.innerHTML = `
                <div class="${styles[type]} border px-4 py-3.5 rounded-2xl text-sm font-semibold flex items-center animate-fade-in">
                    ${icons[type] || ''}
                    <span>${msg}</span>
                </div>
            `;
            setTimeout(() => {
                if (container) container.innerHTML = '';
            }, 5000);
        }

        document.getElementById('change-password-form').addEventListener('submit', async (e) => {
            e.preventDefault();

            const currentPassword = document.getElementById('current-password').value;
            const newPassword = document.getElementById('new-password').value;
            const confirmPassword = document.getElementById('confirm-password').value;

            if (newPassword !== confirmPassword) {
                showMessage('New passwords do not match.', 'error');
                return;
            }

            try {
                const response = await fetchWithAuth(`${API_BASE}/auth/change-password`, {
                    method: 'POST',
                    body: JSON.stringify({ current_password: currentPassword, new_password: newPassword }),
                });
                const data = await response.json();
                if (data.success) {
                    showMessage('Password changed successfully!', 'success');
                    e.target.reset();
                } else {
                    showMessage(data.message || 'Password change failed', 'error');
                }
            } catch (err) {
                showMessage('Network error. Please try again.', 'error');
            }
        });
    </script>
</body>
</html>
