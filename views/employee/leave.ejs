<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leave Requests - Attendance System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 text-slate-600 min-h-screen flex flex-col">
    <!-- Navbar -->
    <nav class="sticky top-0 z-40 glass-nav">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 bg-slate-900 rounded-xl flex items-center justify-center text-white">
                    <i class="fa-solid fa-calendar-minus text-base"></i>
                </div>
                <div class="leading-tight">
                    <span class="text-sm font-bold text-slate-900 tracking-tight">Attendance</span>
                    <p class="text-[11px] text-slate-400 font-medium hidden sm:block">Leave Requests</p>
                </div>
            </div>

            <div class="flex items-center space-x-3">
                <a href="/employee/dashboard" class="text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:border-slate-300 px-3 py-2 rounded-lg transition shadow-sm flex items-center space-x-1">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/logout" class="text-xs font-semibold text-slate-500 hover:text-rose-600 bg-white border border-slate-200 hover:border-rose-200 px-3 py-2 rounded-lg transition shadow-sm">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 flex-1 w-full space-y-6">

        <!-- Hero -->
        <div class="surface-card p-6 sm:p-8 relative overflow-hidden">
            <div class="absolute -top-20 -right-20 w-64 h-64 bg-indigo-100 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative z-10">
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Leave Management</p>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Request Leave</h1>
                <p class="text-sm text-slate-500">Submit your leave request and track approval status here.</p>
            </div>
        </div>

        <div id="status-message"></div>

        <!-- Request Form -->
        <div class="surface-card p-6 sm:p-7">
            <div class="flex items-center space-x-3 mb-5">
                <div class="w-9 h-9 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold">
                    <i class="fa-solid fa-calendar-plus text-sm"></i>
                </div>
                <div>
                    <h2 class="text-sm font-bold text-slate-900 tracking-tight">New Leave Request</h2>
                    <p class="text-xs text-slate-400 mt-0.5">Fill in the details below to request time off</p>
                </div>
            </div>

            <form id="leave-form" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Leave Type</label>
                    <select id="leave-type" required
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                        <option value="sick">Sick Leave (Full Day)</option>
                        <option value="paid">Paid Leave (Full Day)</option>
                        <option value="unpaid">Unpaid Leave (Full Day)</option>
                        <option value="partial">Partial Day (Hourly Leave)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Start Date</label>
                    <input type="date" id="leave-start" required
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                </div>

                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">End Date</label>
                    <input type="date" id="leave-end" required
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                </div>

                <div id="partial-fields" class="md:col-span-2 hidden bg-indigo-50/60 border border-indigo-200/60 p-4 rounded-2xl">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-indigo-900 text-xs font-bold uppercase tracking-wider mb-1.5">From Time</label>
                            <input type="time" id="partial-from" value="09:00"
                                class="w-full px-3.5 py-2 bg-white border border-indigo-200 rounded-xl text-sm font-semibold focus:outline-none focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-indigo-900 text-xs font-bold uppercase tracking-wider mb-1.5">To Time</label>
                            <input type="time" id="partial-to" value="11:00"
                                class="w-full px-3.5 py-2 bg-white border border-indigo-200 rounded-xl text-sm font-semibold focus:outline-none focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-indigo-900 text-xs font-bold uppercase tracking-wider mb-1.5">Calculated Duration</label>
                            <input type="text" id="partial-hours-display" readonly
                                class="w-full px-3.5 py-2 bg-indigo-100 border border-indigo-200 rounded-xl text-sm font-bold text-indigo-800"
                                value="2 hours">
                            <input type="hidden" id="partial-hours" value="2">
                        </div>
                    </div>
                </div>

                <div class="md:col-span-2">
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Reason / Notes</label>
                    <textarea id="leave-notes" rows="3"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:bg-white transition"
                        placeholder="Optional explanation..."></textarea>
                </div>

                <div class="md:col-span-2 pt-2 flex justify-end">
                    <button type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-8 py-3 rounded-xl text-sm transition shadow-sm flex items-center space-x-2">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>Submit Leave Request</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- History -->
        <div class="surface-card overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-bold text-slate-900 tracking-tight">My Leave Requests</h2>
                    <p class="text-xs text-slate-400 mt-0.5">Your submitted leave requests and their status</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 border-b border-slate-100">
                        <tr>
                            <th class="py-3 px-6">Type</th>
                            <th class="py-3 px-4">Date Range</th>
                            <th class="py-3 px-4">Details</th>
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4">Requested</th>
                        </tr>
                    </thead>
                    <tbody id="leave-history" class="divide-y divide-slate-100">
                        <tr>
                            <td colspan="5" class="py-12 text-center text-slate-400 text-sm">
                                <div class="inline-flex items-center space-x-2">
                                    <i class="fa-solid fa-circle-notch fa-spin text-indigo-500 text-base"></i>
                                    <span>Loading requests...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mt-auto py-6 border-t border-slate-200/80 bg-white/60">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center text-xs text-slate-400 font-medium">
            <p>&copy; <%= new Date().getFullYear() %> Attendance Management System. Bound to Office Device.</p>
        </div>
    </footer>

    <script>
        const API_BASE = '/api';
        const AUTH_TOKEN = '<%= token || "" %>';
        const DAKHA_TIME_ZONE = 'Asia/Dhaka';

        async function getStoredToken() {
            if (AUTH_TOKEN && AUTH_TOKEN !== '') {
                return AUTH_TOKEN;
            }
            return localStorage.getItem('token');
        }

        function dhakaDateInputValue() {
            const parts = new Intl.DateTimeFormat('en-US', {
                timeZone: DAKHA_TIME_ZONE,
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hourCycle: 'h23',
            }).formatToParts(new Date());
            const mapped = {};
            for (const part of parts) {
                if (part.type !== 'literal') mapped[part.type] = part.value;
            }
            return `${mapped.year}-${mapped.month}-${mapped.day}`;
        }

        async function fetchWithAuth(url, options = {}) {
            const token = await getStoredToken();
            const headers = {
                'Content-Type': 'application/json',
                ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
            };
            const response = await fetch(url, { ...options, headers });
            return response;
        }

        function showMessage(msg, type = 'info') {
            const container = document.getElementById('status-message');
            const icons = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500 text-base mr-2"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500 text-base mr-2"></i>',
                info: '<i class="fa-solid fa-circle-info text-blue-500 text-base mr-2"></i>',
            };
            const styles = {
                success: 'bg-emerald-50/90 border-emerald-200 text-emerald-800 shadow-sm',
                error: 'bg-rose-50/90 border-rose-200 text-rose-800 shadow-sm',
                info: 'bg-blue-50/90 border-blue-200 text-blue-800 shadow-sm',
            };
            container.innerHTML = `
                <div class="${styles[type]} border px-4 py-3.5 rounded-xl text-sm font-semibold flex items-center animate-fade-in">
                    ${icons[type] || ''}
                    <span>${msg}</span>
                </div>
            `;
            setTimeout(() => {
                if (container) container.innerHTML = '';
            }, 5000);
        }

        function formatDate(dateStr) {
            if (!dateStr) return '—';
            const d = new Date(dateStr + 'T00:00:00');
            return new Intl.DateTimeFormat('en-US', {
                timeZone: DAKHA_TIME_ZONE,
                month: 'short',
                day: 'numeric',
                year: 'numeric',
            }).format(d);
        }

        function formatDateTime(dateStr) {
            if (!dateStr) return '—';
            return new Intl.DateTimeFormat('en-US', {
                timeZone: DAKHA_TIME_ZONE,
                month: 'short',
                day: 'numeric',
                year: 'numeric',
            }).format(new Date(dateStr));
        }

        function calculateHours() {
            const from = document.getElementById('partial-from').value;
            const to = document.getElementById('partial-to').value;
            if (!from || !to) return;
            const [fromH, fromM] = from.split(':').map(Number);
            const [toH, toM] = to.split(':').map(Number);
            const totalMinutes = (toH * 60 + toM) - (fromH * 60 + fromM);
            if (totalMinutes <= 0) {
                document.getElementById('partial-hours-display').value = 'Invalid range';
                document.getElementById('partial-hours').value = 0;
                return;
            }
            const hours = totalMinutes / 60;
            document.getElementById('partial-hours').value = hours;
            document.getElementById('partial-hours-display').value = hours + (hours === 1 ? ' hour' : ' hours');
        }

        document.getElementById('leave-type').addEventListener('change', function() {
            const partialFields = document.getElementById('partial-fields');
            if (this.value === 'partial') {
                partialFields.classList.remove('hidden');
                calculateHours();
            } else {
                partialFields.classList.add('hidden');
            }
        });
        document.getElementById('partial-from').addEventListener('change', calculateHours);
        document.getElementById('partial-to').addEventListener('change', calculateHours);

        const todayInput = dhakaDateInputValue();
        document.getElementById('leave-start').min = todayInput;
        document.getElementById('leave-end').min = todayInput;

        document.getElementById('leave-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const leaveType = document.getElementById('leave-type').value;
            const body = {
                start_date: document.getElementById('leave-start').value,
                end_date: document.getElementById('leave-end').value,
                leave_type: leaveType,
                notes: document.getElementById('leave-notes').value.trim() || undefined,
            };
            if (leaveType === 'partial') {
                body.partial_hours = parseFloat(document.getElementById('partial-hours').value);
                body.partial_from = document.getElementById('partial-from').value;
                body.partial_to = document.getElementById('partial-to').value;
            }

            try {
                const response = await fetchWithAuth(`${API_BASE}/leaves`, { method: 'POST', body: JSON.stringify(body) });
                const data = await response.json();
                if (data.success) {
                    showMessage('Leave request submitted. Waiting for admin approval.', 'success');
                    e.target.reset();
                    document.getElementById('partial-fields').classList.add('hidden');
                    loadHistory();
                } else {
                    showMessage(data.message || 'Failed to submit request', 'error');
                }
            } catch (err) {
                showMessage('Network error. Please try again.', 'error');
            }
        });

        async function loadHistory() {
            try {
                const response = await fetchWithAuth(`${API_BASE}/leaves`);
                const data = await response.json();
                const container = document.getElementById('leave-history');

                const leaves = data.data || [];
                if (leaves.length === 0) {
                    container.innerHTML = `
                        <tr>
                            <td colspan="5" class="py-12 text-center text-slate-400 text-xs font-medium">
                                <i class="fa-regular fa-folder-open text-xl text-slate-300 mb-1 block"></i>
                                <span>No leave requests submitted yet.</span>
                            </td>
                        </tr>
                    `;
                    return;
                }

                container.innerHTML = leaves.map(leave => {
                    const typeLabels = { sick: 'Sick Leave', paid: 'Paid Leave', unpaid: 'Unpaid Leave', partial: 'Partial Day' };
                    const typeColors = {
                        sick: 'bg-rose-50 text-rose-700 border-rose-200',
                        paid: 'bg-blue-50 text-blue-700 border-blue-200',
                        unpaid: 'bg-slate-100 text-slate-700 border-slate-200',
                        partial: 'bg-purple-50 text-purple-700 border-purple-200'
                    };
                    const statusColors = {
                        Pending: 'bg-amber-50 text-amber-700 border-amber-200',
                        Approved: 'bg-emerald-50 text-emerald-700 border-emerald-200',
                        Rejected: 'bg-rose-50 text-rose-600 border-rose-200',
                    };
                    const status = leave.status || 'Pending';
                    const typeLabel = typeLabels[leave.leave_type] || leave.leave_type;
                    const typeColor = typeColors[leave.leave_type] || 'bg-slate-100 text-slate-600 border-slate-200';

                    let detail = '';
                    if (leave.leave_type === 'partial') {
                        const label = leave.partial_label || 'Partial';
                        detail = `<span class="text-xs font-semibold text-purple-600"><i class="fa-regular fa-clock mr-1"></i>${leave.partial_hours}h (${leave.partial_from} - ${leave.partial_to}) &middot; ${label}</span>`;
                    }
                    if (leave.notes) {
                        detail += `<p class="text-xs text-slate-400 italic font-medium mt-0.5">"${leave.notes}"</p>`;
                    }

                    return `
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3.5 px-6"><span class="px-3 py-1 text-xs font-bold rounded-xl border ${typeColor}">${typeLabel}</span></td>
                            <td class="py-3.5 px-4 font-semibold text-slate-700 text-xs">
                                <i class="fa-regular fa-calendar mr-1 text-slate-400"></i>${formatDate(leave.start_date)} to ${formatDate(leave.end_date)}
                            </td>
                            <td class="py-3.5 px-4">${detail || '<span class="text-slate-300">—</span>'}</td>
                            <td class="py-3.5 px-4"><span class="px-2.5 py-1 text-xs font-bold rounded-lg border ${statusColors[status] || 'bg-slate-100 text-slate-600 border-slate-200'}">${status}</span></td>
                            <td class="py-3.5 px-4 text-xs font-medium text-slate-400">${formatDateTime(leave.created_at)}</td>
                        </tr>
                    `;
                }).join('');
            } catch (err) {
                console.error(err);
            }
        }

        loadHistory();
    </script>
</body>
</html>