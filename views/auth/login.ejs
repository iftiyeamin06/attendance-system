<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Attendance System - Sign In' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 text-slate-600 min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
    <!-- Ambient Blur Background Blobs -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-100 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-emerald-100 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10 animate-fade-in">
        <!-- Main Card -->
        <div class="bg-white border border-slate-200 p-8 rounded-2xl shadow-lg shadow-slate-200/60">
            <!-- Header Logo -->
            <div class="text-center mb-8">
                <div class="w-14 h-14 bg-slate-900 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-sm">
                    <i class="fa-solid fa-clock-rotate-left text-indigo-400 text-xl"></i>
                </div>
                <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Attendance System</h1>
                <p class="text-slate-400 text-xs mt-1 font-medium">Sign in to your workspaces</p>
            </div>

            <% if (error) { %>
            <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl mb-6 text-xs font-semibold flex items-center space-x-2">
                <i class="fa-solid fa-circle-exclamation text-rose-400 text-sm"></i>
                <span><%= error %></span>
            </div>
            <% } %>

            <!-- Role Tabs -->
            <div class="grid grid-cols-2 gap-1 bg-slate-100 p-1 rounded-xl mb-6">
                <button type="button" id="tab-employee" onclick="selectRole('employee')"
                    class="flex items-center justify-center space-x-2 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all role-tab"
                    style="background-color:#0f172a;color:#fff;">
                    <i class="fa-solid fa-user"></i>
                    <span>Employee Login</span>
                </button>
                <button type="button" id="tab-admin" onclick="selectRole('admin')"
                    class="flex items-center justify-center space-x-2 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all role-tab"
                    style="background-color:transparent;color:#64748b;">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>Admin Login</span>
                </button>
            </div>

            <!-- Unified Form -->
            <form action="/api/auth/login-web" method="POST" class="space-y-4">
                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Work Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-regular fa-envelope"></i>
                        </div>
                        <input type="email" id="email-input" name="email" required
                            class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 focus:bg-white transition-all"
                            placeholder="you@company.com">
                    </div>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider">Password</label>
                    </div>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <input type="password" id="password-input" name="password" required
                            class="w-full pl-11 pr-12 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 focus:bg-white transition-all"
                            placeholder="••••••••">
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600">
                            <i class="fa-regular fa-eye" id="eye-icon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit"
                    class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 rounded-xl shadow-sm transition-all duration-200 text-sm flex items-center justify-center space-x-2 mt-2 group">
                    <span id="submit-label">Sign In to Dashboard</span>
                    <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                </button>
            </form>

            <!-- Quick Demo Creds Chip -->
            <div class="mt-6 pt-6 border-t border-slate-100 text-center">
                <button type="button" onclick="fillDemo()" class="inline-flex items-center space-x-2 bg-slate-50 hover:bg-slate-100 text-slate-600 border border-slate-200 px-3.5 py-2 rounded-lg text-xs font-medium transition group">
                    <i class="fa-solid fa-wand-magic-sparkles text-indigo-500"></i>
                    <span id="demo-label">Fill Demo Credentials</span>
                </button>
            </div>
        </div>

        <!-- Tip Footer -->
        <div class="text-center mt-6">
            <p class="text-xs font-semibold text-slate-400 inline-flex items-center space-x-2">
                <i class="fa-solid fa-circle-check text-emerald-500"></i>
                <span>Use the same sign-in for both Employees and Admins — we'll route you automatically.</span>
            </p>
        </div>
    </div>

    <script>
        let currentRole = 'employee';

        const DEMO = {
            employee: ['employee@attendance.local', 'employee123'],
            admin: ['admin@attendance.local', 'admin123'],
        };

        function selectRole(role) {
            currentRole = role;
            const employeeTab = document.getElementById('tab-employee');
            const adminTab = document.getElementById('tab-admin');
            const active = role === 'admin' ? adminTab : employeeTab;
            const inactive = role === 'admin' ? employeeTab : adminTab;

            active.style.backgroundColor = '#0f172a';
            active.style.color = '#fff';
            inactive.style.backgroundColor = 'transparent';
            inactive.style.color = '#64748b';

            document.getElementById('demo-label').textContent = role === 'admin' ? 'Fill Admin Credentials' : 'Fill Employee Credentials';
            document.getElementById('submit-label').textContent = role === 'admin' ? 'Sign In to Admin Workspace' : 'Sign In to Dashboard';
            document.getElementById('email-input').placeholder = role === 'admin' ? 'admin@company.com' : 'employee@company.com';
            if (document.getElementById('email-input').value) {
                document.getElementById('email-input').value = '';
                document.getElementById('password-input').value = '';
            }
        }

        function fillDemo() {
            const [email, pwd] = DEMO[currentRole];
            document.getElementById('email-input').value = email;
            document.getElementById('password-input').value = pwd;
        }

        function togglePasswordVisibility() {
            const pwdInput = document.getElementById('password-input');
            const eyeIcon = document.getElementById('eye-icon');
            if (pwdInput.type === 'password') {
                pwdInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                pwdInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>