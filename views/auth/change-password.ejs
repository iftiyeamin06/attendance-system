<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance System - Change Password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 text-slate-600 min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-100 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-emerald-100 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10 animate-fade-in">
        <div class="bg-white border border-slate-200 p-8 rounded-2xl shadow-lg shadow-slate-200/60">
            <div class="text-center mb-8">
                <div class="w-14 h-14 bg-slate-900 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-sm">
                    <i class="fa-solid fa-shield-halved text-indigo-400 text-xl"></i>
                </div>
                <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Change Password</h1>
                <p class="text-slate-400 text-xs mt-1 font-medium">
                    <%= typeof user !== 'undefined' && user.mustChangePassword ? 'Your password was reset. Please set a new one to continue.' : 'Update your account password' %>
                </p>
            </div>

            <div id="error-box" class="hidden bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl mb-6 text-xs font-semibold flex items-center space-x-2">
                <i class="fa-solid fa-circle-exclamation text-rose-400 text-sm"></i>
                <span id="error-msg"></span>
            </div>

            <div id="change-form" class="space-y-4">
                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Current Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <input type="password" id="current-input" required autocomplete="current-password"
                            class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 focus:bg-white transition-all"
                            placeholder="Current password">
                    </div>
                </div>

                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">New Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-solid fa-key"></i>
                        </div>
                        <input type="password" id="new-input" required autocomplete="new-password"
                            class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 focus:bg-white transition-all"
                            placeholder="At least 6 characters">
                    </div>
                </div>

                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Confirm New Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-solid fa-key"></i>
                        </div>
                        <input type="password" id="confirm-input" required autocomplete="new-password"
                            class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 focus:bg-white transition-all"
                            placeholder="Re-enter new password">
                    </div>
                </div>

                <button type="button" onclick="submitChange()" id="submit-btn"
                    class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 rounded-xl shadow-sm transition-all duration-200 text-sm flex items-center justify-center space-x-2 mt-2 group">
                    <span>Update Password</span>
                    <i class="fa-solid fa-check group-hover:translate-x-1 transition-transform"></i>
                </button>
            </div>

            <div id="success-box" class="hidden">
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl mb-4 text-xs font-semibold flex items-center space-x-2">
                    <i class="fa-solid fa-circle-check text-emerald-500"></i>
                    <span>Password updated successfully.</span>
                </div>
                <button type="button" onclick="location.href='/'" class="block w-full text-center bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 rounded-xl shadow-sm transition-all duration-200 text-sm">Go to Dashboard</button>
            </div>

            <% if (typeof user === 'undefined' || !user.mustChangePassword) { %>
            <a href="/" class="block text-center text-indigo-600 hover:text-indigo-700 text-xs font-semibold mt-4">Back to dashboard</a>
            <% } %>
        </div>
    </div>

    <script>
        const AUTH_TOKEN = '<%= typeof token !== "undefined" ? token : "" %>';

        async function submitChange() {
            const current_password = document.getElementById('current-input').value;
            const new_password = document.getElementById('new-input').value;
            const confirm = document.getElementById('confirm-input').value;
            const btn = document.getElementById('submit-btn');
            const errorBox = document.getElementById('error-box');

            errorBox.classList.add('hidden');

            if (!current_password) {
                return showError('Please enter your current password.');
            }
            if (!new_password || new_password.length < 6) {
                return showError('New password must be at least 6 characters long.');
            }
            if (new_password !== confirm) {
                return showError('New passwords do not match.');
            }
            if (!AUTH_TOKEN) {
                return showError('Session expired. Please sign in again.');
            }

            btn.disabled = true;
            btn.querySelector('span').textContent = 'Updating...';

            try {
                const resp = await fetch('/api/auth/change-password', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + AUTH_TOKEN
                    },
                    body: JSON.stringify({ current_password, new_password })
                });
                const data = await resp.json();

                if (!data.success) {
                    showError(data.message || 'An error occurred.');
                    return;
                }

                document.getElementById('change-form').classList.add('hidden');
                document.getElementById('success-box').classList.remove('hidden');
            } catch (err) {
                showError('An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.querySelector('span').textContent = 'Update Password';
            }
        }

        function showError(msg) {
            document.getElementById('error-msg').textContent = msg;
            document.getElementById('error-box').classList.remove('hidden');
        }
    </script>
</body>
</html>