<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance System - Forgot Password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 text-slate-600 min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-100 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-emerald-100 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10 animate-fade-in">
        <div class="bg-white border border-slate-200 p-8 rounded-2xl shadow-lg shadow-slate-200/60">
            
            <!-- Header for Request Form -->
            <div id="form-header" class="text-center mb-8">
                <div class="w-14 h-14 bg-slate-900 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-sm">
                    <i class="fa-solid fa-key text-indigo-400 text-xl"></i>
                </div>
                <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Forgot Password</h1>
                <p class="text-slate-400 text-xs mt-1 font-medium">Enter your work email to reset your password</p>
            </div>

            <!-- Error Banner -->
            <div id="error-box" class="hidden bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl mb-6 text-xs font-semibold flex items-center space-x-2">
                <i class="fa-solid fa-circle-exclamation text-rose-400 text-sm"></i>
                <span id="error-msg"></span>
            </div>

            <!-- Request Form -->
            <div id="request-form" class="space-y-4">
                <div>
                    <label class="block text-slate-700 text-xs font-bold uppercase tracking-wider mb-2">Work Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-regular fa-envelope"></i>
                        </div>
                        <input type="email" id="email-input" required
                            class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 focus:bg-white transition-all"
                            placeholder="you@company.com">
                    </div>
                </div>

                <button type="button" onclick="submitRequest()" id="submit-btn"
                    class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 rounded-xl shadow-sm transition-all duration-200 text-sm flex items-center justify-center space-x-2 mt-2 group">
                    <span>Send Reset Link</span>
                    <i class="fa-solid fa-paper-plane group-hover:translate-x-1 transition-transform"></i>
                </button>

                <a href="/login" class="block text-center text-slate-500 hover:text-slate-700 text-xs font-medium pt-2">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Back to sign in
                </a>
            </div>

            <!-- Success Confirmation Screen -->
            <div id="result-box" class="hidden text-center">
                <div class="w-14 h-14 bg-emerald-50 border border-emerald-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-paper-plane text-emerald-600 text-xl"></i>
                </div>
                <h2 class="text-xl font-extrabold text-slate-900 tracking-tight mb-2">Check your email</h2>
                <p class="text-xs text-slate-500 mb-6 leading-relaxed">
                    If that email is registered with us, a password reset link has been sent to your inbox.
                </p>

                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-6 text-left space-y-2">
                    <div class="flex items-start space-x-2.5 text-xs text-slate-600">
                        <i class="fa-solid fa-clock text-indigo-500 mt-0.5"></i>
                        <span>The link is single-use and expires in <strong>15 minutes</strong>.</span>
                    </div>
                    <div class="flex items-start space-x-2.5 text-xs text-slate-600">
                        <i class="fa-solid fa-inbox text-indigo-500 mt-0.5"></i>
                        <span>Don't see it? Check your spam or junk folder.</span>
                    </div>
                </div>

                <a href="/login" class="block w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 rounded-xl shadow-sm transition-all duration-200 text-sm">
                    Back to Sign In
                </a>

                <button type="button" onclick="tryAnotherEmail()" class="text-xs text-indigo-600 hover:text-indigo-700 font-semibold mt-4 inline-block">
                    Need to use another email?
                </button>
            </div>
        </div>
    </div>

    <script>
        async function submitRequest() {
            const email = document.getElementById('email-input').value.trim();
            const btn = document.getElementById('submit-btn');
            const errorBox = document.getElementById('error-box');

            errorBox.classList.add('hidden');

            if (!email) {
                showError('Please enter your work email.');
                return;
            }

            btn.disabled = true;
            btn.querySelector('span').textContent = 'Sending...';

            try {
                const resp = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await resp.json();

                if (data.success) {
                    document.getElementById('form-header').classList.add('hidden');
                    document.getElementById('request-form').classList.add('hidden');
                    document.getElementById('result-box').classList.remove('hidden');
                } else {
                    showError(data.message || 'An error occurred.');
                }
            } catch (err) {
                showError('An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.querySelector('span').textContent = 'Send Reset Link';
            }
        }

        function tryAnotherEmail() {
            document.getElementById('email-input').value = '';
            document.getElementById('result-box').classList.add('hidden');
            document.getElementById('form-header').classList.remove('hidden');
            document.getElementById('request-form').classList.remove('hidden');
            document.getElementById('email-input').focus();
        }

        function showError(msg) {
            document.getElementById('error-msg').textContent = msg;
            document.getElementById('error-box').classList.remove('hidden');
        }
    </script>
</body>
</html>